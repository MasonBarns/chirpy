        <% if (error) { %><p class="form-error"><%= error %></p><% } %>
        <form method="POST" action="/onboarding">
          <label for="displayName">Display name</label>
          <input id="displayName" name="displayName" class="auth-input" maxlength="40" value="<%= displayName || user.displayName %>" required />
          <label for="handle">Your handle</label>
          <div class="handle-prefix"><input id="handle" name="handle" class="auth-input" maxlength="20" pattern="[A-Za-z0-9_]{3,20}" placeholder="your_handle" value="<%= handle %>" autocomplete="off" required /></div>
          <p class="input-hint">3–20 characters. Letters, numbers, and underscores.</p>
          <div class="form-footnote"><svg><use href="#i-lock"/></svg><span>Your handle can be changed later. Handle changes have a 14-day cooldown.</span></div>
          <button class="auth-btn" type="submit">Create my profile</button>
        </form>
      </section>
    </main>

  <% } else if (page === "public-profile") { %>
    <main class="public-profile-page">
      <a class="public-profile-home" href="/"><img src="/images/chirpy.png?v=1" alt="" width="22" height="22" /> Chirpy public profile</a>
      <header class="public-profile-head">
        <a class="avatar large profile-avatar-link" href="/profile/<%= encodeURIComponent(profileAccount.handle) %>" aria-label="View @<%= profileAccount.handle %>'s profile"><img src="<%= avatarUrl(profileAccount) %>" alt="" onerror="this.removeAttribute('src')" /><span><%= (profileAccount.displayName || profileAccount.username || "?").slice(0,1).toUpperCase() %></span></a>
        <div><h1><%= profileAccount.displayName || profileAccount.username %><%- renderPartnerBadge(profileAccount) %>
          <% if (profileAccount.role === "owner") { %><span class="badge owner" role="img" aria-label="Owner" title="Owner"><svg aria-hidden="true"><use href="#i-crown"/></svg></span>
          <% } else if (profileAccount.role === "manager") { %><span class="badge manager" role="img" aria-label="Management" title="Management"><svg aria-hidden="true"><use href="#i-hammer"/></svg></span>
          <% } else if (profileAccount.role === "moderator") { %><span class="badge moderator" role="img" aria-label="Moderator" title="Moderator"><svg aria-hidden="true"><use href="#i-shield"/></svg></span><% } %>
          <% if (["owner","manager","moderator"].includes(profileAccount.role) || profileAccount.verificationStatus === "verified") { %><span class="badge <%= profileAccount.verificationStatus === "verified" ? "verified" : "staff-check" %>" role="img" aria-label="<%= profileAccount.verificationStatus === "verified" ? "Verified" : "Staff" %>" title="<%= profileAccount.verificationStatus === "verified" ? "Verified" : "Staff" %>"><svg aria-hidden="true"><use href="#i-verified"/></svg></span><% } %>
        </h1><span class="muted">@<%= profileAccount.handle %></span></div>
      </header>
      <% if (profileAccount.bio) { %><p class="public-profile-bio"><%= profileAccount.bio %></p><% } %>
      <div class="profile-stats" aria-label="Profile statistics">
        <span><strong><%= postCount %></strong> posts</span>
        <span><strong><%= followersCount %></strong> followers</span>
        <span><strong><%= followingCount %></strong> following</span>
        <span><strong><%= likesReceived %></strong> likes received</span>
      </div>
      <div class="public-profile-toolbar">
        <nav class="public-profile-tabs" aria-label="Profile posts">
          <a class="public-profile-tab <%= profileView === 'posts' ? 'active' : '' %>" href="/profile/<%= encodeURIComponent(profileAccount.handle) %>?view=posts">Posts</a>
          <a class="public-profile-tab <%= profileView === 'reposts' ? 'active' : '' %>" href="/profile/<%= encodeURIComponent(profileAccount.handle) %>?view=reposts">Reposts</a>
        </nav>
        <% if (viewer && String(viewer._id) !== String(profileAccount._id)) { %>
          <form method="POST" action="/profile/<%= encodeURIComponent(profileAccount.handle) %>/follow">
            <input type="hidden" name="follow" value="<%= isFollowing ? 'false' : 'true' %>" />
            <button class="follow-button" type="submit"><%= isFollowing ? "Following · Unfollow" : "＋ Follow" %></button>
          </form>
        <% } else if (!viewer) { %>
          <a class="follow-button" href="/login?returnTo=<%= encodeURIComponent(`/profile/${profileAccount.handle}`) %>">Sign in to follow</a>
        <% } %>
      </div>
      <% if (profileNotice) { %><p class="profile-notice" role="status"><%= profileNotice %></p><% } %>
      <section aria-label="<%= profileView === 'reposts' ? 'Reposts' : 'Posts' %>">
        <% profilePosts.forEach((post) => { %>
          <% const itemAuthor = post.author || profileAccount; const itemHandle = itemAuthor.handle || itemAuthor.username; const itemName = itemAuthor.displayName || itemAuthor.username; %>
          <article class="post" id="<%= post._id %>">
            <% if (profileView === "reposts") { %><div class="repost-note">↻ Reposted by @<%= profileAccount.handle %></div><% } %>
            <header class="post-header">
              <a class="avatar profile-avatar-link" href="/profile/<%= encodeURIComponent(itemHandle) %>" aria-label="View @<%= itemHandle %>'s profile"><img src="<%= avatarUrl(itemAuthor) %>" alt="" onerror="this.removeAttribute('src')" /><span><%= itemName.slice(0,1).toUpperCase() %></span></a>
              <div class="post-author"><div class="author-line">
                <a class="author-name" href="/profile/<%= encodeURIComponent(itemHandle) %>"><%= itemName %><%- renderPartnerBadge(itemAuthor) %>
                  <% if (itemAuthor.role === "owner") { %><span class="badge owner" role="img" aria-label="Owner" title="Owner"><svg aria-hidden="true"><use href="#i-crown"/></svg></span>
                  <% } else if (itemAuthor.role === "manager") { %><span class="badge manager" role="img" aria-label="Management" title="Management"><svg aria-hidden="true"><use href="#i-hammer"/></svg></span>
                  <% } else if (itemAuthor.role === "moderator") { %><span class="badge moderator" role="img" aria-label="Moderator" title="Moderator"><svg aria-hidden="true"><use href="#i-shield"/></svg></span><% } %>
                  <% if (["owner","manager","moderator"].includes(itemAuthor.role) || itemAuthor.verificationStatus === "verified") { %><span class="badge <%= itemAuthor.verificationStatus === "verified" ? "verified" : "staff-check" %>" role="img" aria-label="<%= itemAuthor.verificationStatus === "verified" ? "Verified" : "Staff" %>" title="<%= itemAuthor.verificationStatus === "verified" ? "Verified" : "Staff" %>"><svg aria-hidden="true"><use href="#i-verified"/></svg></span><% } %>
                </a>
                <a class="author-handle" href="/profile/<%= encodeURIComponent(itemHandle) %>">@<%= itemHandle %></a>
                <time class="timestamp local-time" datetime="<%= new Date(post.createdAt).toISOString() %>"><%= new Date(post.createdAt).toISOString() %></time>
              </div></div>
            </header>
            <% if (post.text) { %><div class="post-body"><%= post.text %></div><% } %>
            <% if (post.imageMime) { %><button type="button" class="post-image-button" data-image-src="/posts/<%= post._id %>/image" aria-label="Open post image"><img class="post-image" src="/posts/<%= post._id %>/image" alt="Post attachment; activate to view larger" loading="lazy" decoding="async" /><span class="image-load-fallback" hidden>Image unavailable</span></button><% } %>
          </article>
        <% }) %>
        <% if (!profilePosts.length) { %><div class="empty"><strong><%= profileView === "reposts" ? "No reposts yet" : "No public posts yet" %></strong></div><% } %>
      </section>
    </main>

  <% } else if (page === "app") { %>
    <div class="app-shell">
      <aside class="sidebar">
        <a class="brand" href="/app"><img src="/images/chirpy.png?v=1" alt="" /><span class="brand-name">CHIRPY</span></a>
        <div class="profile-mini"><a class="avatar small profile-avatar-link" href="/profile/<%= encodeURIComponent(user.handle) %>" aria-label="View your public profile"><img src="<%= avatarUrl(user) %>" alt="" onerror="this.dataset.fallback='';this.removeAttribute('src')" /><span><%= user.displayName.slice(0,1).toUpperCase() %></span></a><div class="mini-name"><%= user.displayName %><span class="mini-badges"><%- renderPartnerBadge(user) %><% if (user.role === "owner") { %><span class="badge owner" role="img" aria-label="Owner" title="Owner"><svg aria-hidden="true"><use href="#i-crown"/></svg></span><% } else if (user.role === "manager") { %><span class="badge manager" role="img" aria-label="Management" title="Management"><svg aria-hidden="true"><use href="#i-hammer"/></svg></span><% } else if (user.role === "moderator") { %><span class="badge moderator" role="img" aria-label="Moderator" title="Moderator"><svg aria-hidden="true"><use href="#i-shield"/></svg></span><% } %><% if (["owner","manager","moderator"].includes(user.role) || user.verificationStatus === "verified") { %><span class="badge <%= user.verificationStatus === "verified" ? "verified" : "staff-check" %>" role="img" aria-label="<%= user.verificationStatus === "verified" ? "Verified" : "Staff" %>" title="<%= user.verificationStatus === "verified" ? "Verified" : "Staff" %>"><svg aria-hidden="true"><use href="#i-verified"/></svg></span><% } %></span><span>@<%= user.handle %></span></div></div>
        <nav class="nav" aria-label="Main navigation">
          <a class="nav-link <%= activeTab === 'home' ? 'active' : '' %>" href="/app"><svg><use href="#i-home"/></svg><span>Home</span></a>
          <a class="nav-link <%= activeTab === 'explore' ? 'active' : '' %>" href="/app?tab=explore"><svg><use href="#i-search"/></svg><span>Explore</span></a>
          <a class="nav-link <%= activeTab === 'messages' ? 'active' : '' %>" href="/app?tab=messages"><svg><use href="#i-mail"/></svg><span>Messages</span></a>
          <a class="nav-link <%= activeTab === 'notifications' ? 'active' : '' %>" href="/app?tab=notifications"><svg><use href="#i-bell"/></svg><span>Notifications<% if (unreadNotificationCount) { %> · <%= unreadNotificationCount > 99 ? "99+" : unreadNotificationCount %><% } %></span></a>
          <a class="nav-link <%= activeTab === 'bookmarks' ? 'active' : '' %>" href="/app?tab=bookmarks"><svg><use href="#i-bookmark"/></svg><span>Bookmarks</span></a>
          <a class="nav-link <%= activeTab === 'profile' ? 'active' : '' %>" href="/app?tab=profile"><svg><use href="#i-user"/></svg><span>Profile</span></a>
          <a class="nav-link settings-link <%= activeTab === 'settings' ? 'active' : '' %>" href="/app?tab=settings"><svg viewBox="0 0 24 24"><use href="#i-settings"/></svg><span>Settings</span></a>
          <% if (["moderator","manager","owner"].includes(user.role)) { %><a class="nav-link <%= activeTab === 'moderation' ? 'active' : '' %>" href="/moderation"><svg><use href="#i-hammer"/></svg><span>Mod panel</span></a><% } %>
          <% if (["moderator","manager","owner"].includes(user.role)) { %><a class="nav-link <%= activeTab === 'logs' ? 'active' : '' %>" href="/app?tab=logs"><svg><use href="#i-audit"/></svg><span>Mod logs</span></a><% } %>
          <% if (["manager","owner"].includes(user.role)) { %><a class="nav-link <%= activeTab === 'banland' ? 'active' : '' %>" href="/app?tab=banland"><svg><use href="#i-shield"/></svg><span>Banland</span></a><% } %>
        </nav>
        <% if (activeTab === "home" || activeTab === "explore") { %><button class="create-btn" id="openComposer" type="button">＋ Create post</button><% } %>
        <div class="sidebar-bottom"><a class="avatar small profile-avatar-link" href="/profile/<%= encodeURIComponent(user.handle) %>" aria-label="View your public profile"><img src="<%= avatarUrl(user) %>" alt="" onerror="this.dataset.fallback='';this.removeAttribute('src')" /><span><%= user.displayName.slice(0,1).toUpperCase() %></span></a><div class="mini-name"><%= user.displayName %><span class="mini-badges"><%- renderPartnerBadge(user) %><% if (user.role === "owner") { %><span class="badge owner" role="img" aria-label="Owner" title="Owner"><svg aria-hidden="true"><use href="#i-crown"/></svg></span><% } else if (user.role === "manager") { %><span class="badge manager" role="img" aria-label="Management" title="Management"><svg aria-hidden="true"><use href="#i-hammer"/></svg></span><% } else if (user.role === "moderator") { %><span class="badge moderator" role="img" aria-label="Moderator" title="Moderator"><svg aria-hidden="true"><use href="#i-shield"/></svg></span><% } %><% if (["owner","manager","moderator"].includes(user.role) || user.verificationStatus === "verified") { %><span class="badge <%= user.verificationStatus === "verified" ? "verified" : "staff-check" %>" role="img" aria-label="<%= user.verificationStatus === "verified" ? "Verified" : "Staff" %>" title="<%= user.verificationStatus === "verified" ? "Verified" : "Staff" %>"><svg aria-hidden="true"><use href="#i-verified"/></svg></span><% } %></span><span>@<%= user.handle %></span></div><form method="POST" action="/logout"><button class="logout-btn" aria-label="Sign out">↗</button></form></div>
      </aside>

      <main class="feed">
        <div class="feed-top">
          <% if (activeTab === "explore") { %><form class="search-form" method="GET" action="/app"><input type="hidden" name="tab" value="explore" /><input class="search-input" name="q" value="<%= query %>" placeholder="Search posts and people…" /></form>
          <% } else { %><div style="flex:1;font-weight:600"><%= activeTab === "home" ? "Home" : activeTab === "profile" ? "Profile" : activeTab === "banland" ? "Banland" : activeTab.charAt(0).toUpperCase() + activeTab.slice(1) %></div><% } %>
        </div>
        <% if (muteInfo) { %><div class="mute-banner" role="status"><strong>Your account is muted.</strong> Posting and interactions are disabled.<% if (muteInfo.until) { %><small>Mute expires <time class="local-time" datetime="<%= new Date(muteInfo.until).toISOString() %>"><%= new Date(muteInfo.until).toISOString() %></time> · <span class="mute-countdown" data-until="<%= new Date(muteInfo.until).toISOString() %>"></span></small><% } else { %><small>This mute is permanent until staff removes it.</small><% } %><% if (muteInfo.reason) { %><small>Reason: <%= muteInfo.reason %></small><% } %></div><% } %>
        <div class="app-toast" id="appToast" role="status" aria-live="polite" data-message="<%= notice %>"></div>
        <template id="pollComposerTemplate">
          <div class="composer-poll-row"><button class="poll-toggle" type="button" aria-pressed="false">＋ Add poll</button></div>
          <div class="poll-editor" hidden>
            <input class="poll-question" maxlength="180" placeholder="Ask a question" aria-label="Poll question" />
            <input class="poll-option" maxlength="80" placeholder="Option 1" aria-label="Poll option 1" />
            <input class="poll-option" maxlength="80" placeholder="Option 2" aria-label="Poll option 2" />
            <input class="poll-option" maxlength="80" placeholder="Option 3 (optional)" aria-label="Poll option 3" />
            <input class="poll-option" maxlength="80" placeholder="Option 4 (optional)" aria-label="Poll option 4" />
          </div>
        </template>

        <% if (activeTab === "home") { %><div class="tabs"><a class="tab active" href="/app">For you</a><a class="tab" href="/app?tab=explore">Explore</a></div><% } %>

        <% if (activeTab === "profile") { %>
          <section class="profile-header">
            <div class="profile-info"><a class="avatar large profile-avatar-link" href="/profile/<%= encodeURIComponent(user.handle) %>" aria-label="View your public profile"><img src="<%= avatarUrl(user) %>" alt="" onerror="this.dataset.fallback='';this.removeAttribute('src')" /><span><%= user.displayName.slice(0,1).toUpperCase() %></span></a><div><h2><%= user.displayName %><%- renderPartnerBadge(user) %>
              <% if (user.role === "owner") { %><span class="badge owner" role="img" aria-label="Owner" title="Owner"><svg aria-hidden="true"><use href="#i-crown"/></svg></span>
              <% } else if (user.role === "manager") { %><span class="badge manager" role="img" aria-label="Management" title="Management"><svg aria-hidden="true"><use href="#i-hammer"/></svg></span>
              <% } else if (user.role === "moderator") { %><span class="badge moderator" role="img" aria-label="Moderator" title="Moderator"><svg aria-hidden="true"><use href="#i-shield"/></svg></span><% } %>
              <% if (["owner","manager","moderator"].includes(user.role) || user.verificationStatus === "verified") { %><span class="badge <%= user.verificationStatus === "verified" ? "verified" : "staff-check" %>" role="img" aria-label="<%= user.verificationStatus === "verified" ? "Verified" : "Staff" %>" title="<%= user.verificationStatus === "verified" ? "Verified" : "Staff" %>"><svg aria-hidden="true"><use href="#i-verified"/></svg></span><% } %>
            </h2><div class="muted">@<%= user.handle %></div></div></div>
            <p class="profile-bio"><%= user.bio || "No bio yet. Add one in Settings." %></p>
            <div class="profile-stats" aria-label="Profile statistics"><span><strong><%= postCount %></strong> posts</span><span><strong><%= followersCount %></strong> followers</span><span><strong><%= followingCount %></strong> following</span><span><strong><%= likesReceived %></strong> likes received</span></div>
            <nav class="profile-tabs"><a class="profile-tab <%= profileView === 'posts' ? 'active' : '' %>" href="/app?tab=profile&profileView=posts">Posts</a><a class="profile-tab <%= profileView === 'reposts' ? 'active' : '' %>" href="/app?tab=profile&profileView=reposts">Reposts</a></nav>
          </section>
          <button class="create-btn" id="openComposer" type="button" style="width:100%;margin:16px 0">＋ Create post</button>
          <form class="composer" method="POST" action="/posts" id="composer" hidden><div class="composer-row"><div class="composer-identity"><div class="avatar"><img src="<%= avatarUrl(user) %>" alt="" onerror="this.dataset.fallback='';this.removeAttribute('src')" /><span><%= user.displayName.slice(0,1).toUpperCase() %></span></div><div class="composer-label"><strong><%= user.displayName %></strong><span><% if (user.role === "owner") { %><span class="badge owner" role="img" aria-label="Owner" title="Owner"><svg aria-hidden="true"><use href="#i-crown"/></svg></span><% } else if (user.role === "manager") { %><span class="badge manager" role="img" aria-label="Management" title="Management"><svg aria-hidden="true"><use href="#i-hammer"/></svg></span><% } else if (user.role === "moderator") { %><span class="badge moderator" role="img" aria-label="Moderator" title="Moderator"><svg aria-hidden="true"><use href="#i-shield"/></svg></span><% } %><% if (["owner","manager","moderator"].includes(user.role) || user.verificationStatus === "verified") { %><span class="badge <%= user.verificationStatus === "verified" ? "verified" : "staff-check" %>" role="img" aria-label="<%= user.verificationStatus === "verified" ? "Verified" : "Staff" %>" title="<%= user.verificationStatus === "verified" ? "Verified" : "Staff" %>"><svg aria-hidden="true"><use href="#i-verified"/></svg></span><% } %></span></div></div><textarea name="text" maxlength="500" placeholder="What's happening?"></textarea></div><div class="composer-upload-row"><label class="image-upload-button">＋ Add image<input class="image-upload-input" type="file" name="image" accept="image/png,image/jpeg,image/gif,image/webp" /></label><span class="upload-name" aria-live="polite">PNG, JPG, GIF or WebP · up to 5 MB</span></div><div class="upload-error" role="alert" hidden></div><div class="image-preview" hidden><img alt="Selected image preview" /><button type="button" class="remove-image">Remove image</button></div><div class="composer-bottom"><span class="char-count">0/500</span><button class="post-submit" type="submit">Post</button></div></form>
        <% } %>

        <% if (activeTab === "home" || activeTab === "explore") { %>
          <form class="composer" method="POST" action="/posts" id="composer" hidden><div class="composer-row"><div class="composer-identity"><div class="avatar"><img src="<%= avatarUrl(user) %>" alt="" onerror="this.dataset.fallback='';this.removeAttribute('src')" /><span><%= user.displayName.slice(0,1).toUpperCase() %></span></div><div class="composer-label"><strong><%= user.displayName %></strong><span><% if (user.role === "owner") { %><span class="badge owner" role="img" aria-label="Owner" title="Owner"><svg aria-hidden="true"><use href="#i-crown"/></svg></span><% } else if (user.role === "manager") { %><span class="badge manager" role="img" aria-label="Management" title="Management"><svg aria-hidden="true"><use href="#i-hammer"/></svg></span><% } else if (user.role === "moderator") { %><span class="badge moderator" role="img" aria-label="Moderator" title="Moderator"><svg aria-hidden="true"><use href="#i-shield"/></svg></span><% } %><% if (["owner","manager","moderator"].includes(user.role) || user.verificationStatus === "verified") { %><span class="badge <%= user.verificationStatus === "verified" ? "verified" : "staff-check" %>" role="img" aria-label="<%= user.verificationStatus === "verified" ? "Verified" : "Staff" %>" title="<%= user.verificationStatus === "verified" ? "Verified" : "Staff" %>"><svg aria-hidden="true"><use href="#i-verified"/></svg></span><% } %></span></div></div><textarea name="text" maxlength="500" placeholder="What's happening?"></textarea></div><div class="composer-upload-row"><label class="image-upload-button">＋ Add image<input class="image-upload-input" type="file" name="image" accept="image/png,image/jpeg,image/gif,image/webp" /></label><span class="upload-name" aria-live="polite">PNG, JPG, GIF or WebP · up to 5 MB</span></div><div class="upload-error" role="alert" hidden></div><div class="image-preview" hidden><img alt="Selected image preview" /><button type="button" class="remove-image">Remove image</button></div><div class="composer-bottom"><span class="char-count">0/500</span><button class="post-submit" type="submit">Post</button></div></form>
        <% } %>

        <% if (activeTab === "settings") { %>
          <header class="settings-intro"><h1>Settings</h1><p>Manage your profile, handle, and verification.</p></header>
          <div class="settings-grid">
            <% if (saved) { %><p class="settings-saved">Your changes have been saved.</p><% } %>
            <section class="settings-card">
              <div class="settings-card-heading"><div class="settings-card-icon"><svg><use href="#i-profile"/></svg></div><div><h2>Profile details</h2><p>Update the information people see on Chirpy.</p></div></div>
              <form class="settings-form" method="POST" action="/settings">
                <label>Display name<input name="displayName" maxlength="40" value="<%= user.displayName %>" required /></label>
                <label>Bio<textarea name="bio" maxlength="160"><%= user.bio %></textarea></label>
                <div class="settings-actions"><span class="settings-note">Discord: @<%= user.username %></span><button class="post-submit">Save profile</button></div>
              </form>
            </section>

            <section class="settings-card">
              <div class="settings-card-heading"><div class="settings-card-icon"><svg><use href="#i-bell"/></svg></div><div><h2>Notifications</h2><p>Control social activity alerts for follows, mentions, comments, likes, and reposts.</p></div></div>
              <form class="settings-form" method="POST" action="/settings/notifications">
                <label>Social notifications
                  <select class="field" name="enabled">
                    <option value="true" <%= user.socialNotificationsEnabled === false ? "" : "selected" %>>On</option>
                    <option value="false" <%= user.socialNotificationsEnabled === false ? "selected" : "" %>>Off</option>
                  </select>
                </label>
                <div class="settings-actions"><span class="settings-note">Verification and account-safety notices remain enabled.</span><button class="post-submit">Save notification setting</button></div>
              </form>
            </section>

            <section class="settings-card">
              <div class="settings-card-heading"><div class="settings-card-icon"><svg><use href="#i-settings"/></svg></div><div><h2>Username</h2><p>Change your unique handle once every 14 days.</p></div></div>
              <div class="handle-current"><span>Current handle</span><strong>@<%= user.handle %></strong></div>
              <% if (handleError) { %><p class="settings-error"><%= handleError %></p><% } %>
              <form class="handle-form" method="POST" action="/settings/handle">
                <label>New handle<input name="handle" maxlength="20" pattern="[A-Za-z0-9_]{3,20}" placeholder="new_handle" required /></label>
                <div class="handle-status"><% if (handleChangeAllowed) { %>Handle changes are available now. A successful change starts a new 14-day cooldown.<% } else { %>You can change your handle again on <time class="local-date" datetime="<%= new Date(handleChangeAvailableAt).toISOString() %>"><%= new Date(handleChangeAvailableAt).toISOString() %></time>.<% } %></div>
                <div class="settings-actions"><span class="settings-note">3–20 letters, numbers, or underscores.</span><button class="post-submit" <%= handleChangeAllowed ? "" : "disabled" %>>Update handle</button></div>
              </form>
            </section>

            <section class="settings-card">
              <div class="settings-card-heading"><div class="settings-card-icon"><svg><use href="#i-verified"/></svg></div><div><h2>Verification</h2><p>Apply for an orange verified badge beside your name. Staff emblems are separate and do not grant verified status.</p></div></div>
              <% if (verificationNotice) { %><p class="settings-error" role="status"><%= verificationNotice %></p><% } %>
              <% if (user.verificationStatus === "verified") { %><p class="status-label status-verified">Your account is verified.</p>
              <% } else if (user.verificationStatus === "pending") { %><p class="status-label status-pending">Your application is pending review.</p>
              <% } else { %>
                <% if (user.verificationStatus === "rejected") { %><p class="status-label status-rejected">Your last application was not approved.</p><% } %>
                <% if (maintenanceSettings.verificationEnabled === false) { %>
                  <p class="settings-note">Applications are paused by site staff. You can apply when they reopen.</p>
                <% } else if (!verificationApplicationAvailable) { %>
                  <p class="settings-note">Applications are limited to one every seven days.
                    <% if (verificationApplicationAvailableAt) { %>You can apply again on <time class="local-date" datetime="<%= new Date(verificationApplicationAvailableAt).toISOString() %>"><%= new Date(verificationApplicationAvailableAt).toISOString() %></time>.<% } else { %>Please try again after the cooldown period.<% } %>
                  </p>
                <% } else { %>
                  <form class="verification-form" method="POST" action="/settings/verification">
                    <label>Tell us why your account should be verified<textarea name="reason" minlength="20" maxlength="500" required placeholder="Share relevant public identity or authenticity details."></textarea></label>
                    <button class="post-submit">Submit verification application</button>
                  </form>
                <% } %>
              <% } %>
            </section>
            <section class="settings-card"><strong>Sign out</strong><form method="POST" action="/logout" style="margin-top:12px"><button class="signout-button">Sign out</button></form></section>
          </div>
        <% } %>

        <% if (activeTab === "moderation") { %>
          <div class="feed-heading"><h1>Moderation</h1><p>Staff tools, account roles, and verification review.</p></div>
          <nav class="profile-tabs" aria-label="Moderation tools"><a class="profile-tab active" href="/app?tab=moderation">Moderation</a><a class="profile-tab" href="/app?tab=logs">Logs</a><% if (["manager","owner"].includes(user.role)) { %><a class="profile-tab" href="/app?tab=banland">Banland</a><% } %></nav>
          <% if (["moderator","manager","owner"].includes(user.role)) { %>
            <section class="mod-card">
              <div class="mod-section-title"><h2>Termination appeals</h2><small><%= safePendingAppeals.length %> pending</small></div>
              <% if (!safePendingAppeals.length) { %><div class="empty-small">There are no pending termination appeals.</div><% } %>
              <% safePendingAppeals.forEach((appeal) => { %>
                <article class="mod-user staff-account">
                  <div class="staff-account-info">
                    <div class="mod-user-name"><%= appeal.displayName || appeal.username %> · @<%= appeal.handle || "no-handle" %></div>
                    <div class="mod-user-meta">Discord <%= appeal.discordId %> · Submitted <time class="local-time" datetime="<%= new Date(appeal.appealSubmittedAt).toISOString() %>"><%= new Date(appeal.appealSubmittedAt).toISOString() %></time></div>
                    <div class="application-reason"><%= appeal.appealText %></div>
                    <div class="terminated-meta"><strong>Termination reason:</strong> <%= appeal.terminationReason || "No reason recorded." %></div>
                  </div>
                  <div class="application-actions">
                    <form method="POST" action="/moderation/appeals/<%= appeal._id %>"><input type="hidden" name="decision" value="accept" /><button class="post-submit" type="submit">Accept · Reinstate</button></form>
                    <form method="POST" action="/moderation/appeals/<%= appeal._id %>"><input type="hidden" name="decision" value="deny" /><button class="mod-button danger" type="submit">Deny appeal</button></form>
                  </div>
                </article>
              <% }) %>
            </section>
          <% } %>
          <section class="mod-card">
            <div class="mod-section-title"><h2>Maintenance mode</h2><small><%= maintenanceSettings.enabled ? "Currently on" : "Currently off" %></small></div>
            <% if (["owner","manager"].includes(user.role)) { %>
              <p class="rail-note">Control the public maintenance page and its progress indicator.</p>
              <form class="settings-form" method="POST" action="/moderation/maintenance">
                <label>Site availability
                  <select class="field" name="enabled">
                    <option value="true" <%= maintenanceSettings.enabled ? "selected" : "" %>>Maintenance on</option>
                    <option value="false" <%= maintenanceSettings.enabled ? "" : "selected" %>>Maintenance off</option>
                  </select>
                </label>
                <label>Progress percentage
                  <input class="field" type="number" name="progress" min="0" max="100" step="1" value="<%= maintenanceSettings.progress %>" required />
                </label>
                <div class="settings-actions"><span class="settings-note">Only managers and owners can change these settings.</span><button class="post-submit">Save maintenance settings</button></div>
              </form>
            <% } else { %>
              <p class="rail-note">Maintenance is <%= maintenanceSettings.enabled ? "on" : "off" %>. Managers and owners can change this setting.</p>
            <% } %>
          </section>
          <section class="mod-card">
            <div class="mod-section-title"><h2>Verification applications</h2><small><%= maintenanceSettings.verificationEnabled === false ? "Currently paused" : "Currently open" %></small></div>
            <% if (["owner","manager"].includes(user.role)) { %>
              <p class="rail-note">Choose whether members can submit verification applications. Existing applications remain available for staff review.</p>
              <form class="settings-form" method="POST" action="/moderation/verification-settings">
                <label>Application availability
                  <select class="field" name="enabled">
                    <option value="true" <%= maintenanceSettings.verificationEnabled === false ? "" : "selected" %>>Open applications</option>
                    <option value="false" <%= maintenanceSettings.verificationEnabled === false ? "selected" : "" %>>Pause applications</option>
                  </select>
                </label>
                <div class="settings-actions"><span class="settings-note">Only managers and owners can change this setting.</span><button class="post-submit">Save verification setting</button></div>
              </form>
            <% } else { %>
              <p class="rail-note">Applications are <%= maintenanceSettings.verificationEnabled === false ? "paused" : "open" %>. Managers and owners can change this setting.</p>
            <% } %>
          </section>
          <% if (["owner","manager","moderator"].includes(user.role)) { %>
            <section class="mod-card">
              <div class="mod-section-title"><h2>Verification applications</h2><small><%= applications.length %> pending</small></div>
              <% if (!applications.length) { %><div class="empty-small">No applications need review.</div><% } %>
              <% applications.forEach((applicant) => { %>
                <div class="mod-user" style="display:block">
                  <div class="mod-user-name"><%= applicant.displayName %> · @<%= applicant.handle || "no-handle" %></div>
                  <div class="application-reason"><%= applicant.verificationReason %></div>
                  <div class="application-actions">
                    <form method="POST" action="/moderation/verification/<%= applicant._id %>"><input type="hidden" name="decision" value="approve" /><button class="post-submit">Approve</button></form>
                    <form method="POST" action="/moderation/verification/<%= applicant._id %>"><input type="hidden" name="decision" value="reject" /><button class="mod-button danger">Reject</button></form>
                  </div>
                </div>
              <% }) %>
            </section>
          <% } %>

          <% if (["owner","manager"].includes(user.role)) { %>
            <section class="mod-card">
              <div class="mod-section-title"><h2>Verified accounts</h2><small><%= verifiedUsers.length %> listed</small></div>
              <% if (!verifiedUsers.length) { %><div class="empty-small">No verified non-staff accounts.</div><% } %>
              <% verifiedUsers.forEach((target) => { %>
                <div class="mod-user">
                  <div>
                    <div class="mod-user-name"><%= target.displayName || target.username %> · @<%= target.handle || "no-handle" %></div>
                    <div class="mod-user-meta">Discord <%= target.discordId %> · Verified account</div>
                  </div>
                  <form method="POST" action="/moderation/users/<%= target._id %>/verification/remove" class="confirm-action" data-confirm-title="Remove verification?" data-confirm-message="The verified badge will be removed. The account owner will see a notice the next time they open Chirpy.">
                    <button class="mod-button danger">Remove verification</button>
                  </form>
                </div>
              <% }) %>
            </section>
          <% } %>

          <% if (["owner","manager"].includes(user.role)) { %>
            <section class="mod-card">
              <% const safePendingRoleAssignments = typeof pendingRoleAssignments === "undefined" ? [] : pendingRoleAssignments; %>
              <div class="mod-section-title"><h2>Manage staff by Discord ID</h2><small><%= user.role === "owner" ? "All roles" : "Moderators only" %></small></div>
              <p class="rail-note">Role assignments are saved for users who have not signed in yet.</p>
              <form class="role-form" method="POST" action="/moderation/roles">
                <input class="field" name="discordId" inputmode="numeric" pattern="[0-9]{17,20}" maxlength="20" placeholder="Discord user ID" required />
                <div class="role-assignment-preview" id="roleAssignmentPreview" role="status" aria-live="polite" hidden></div>
                <select class="role-select" name="role" required>
                  <option value="moderator">Moderator</option>
                  <option value="user">Remove staff role</option>
                  <% if (user.role === "owner") { %><option value="manager">Manager</option><option value="owner">Owner</option><% } %>
                </select>
                <button class="role-button">Save role</button>
              </form>
              <% if (safePendingRoleAssignments.length) { %>
                <div class="mod-section-title" style="margin-top:18px"><h2>Waiting for first sign-in</h2><small><%= safePendingRoleAssignments.length %> pending</small></div>
                <% safePendingRoleAssignments.forEach((assignment) => { const assignedUser = roleAssignmentUserMap && roleAssignmentUserMap[assignment.discordId]; %>
                  <div class="mod-user">
                    <div class="role-assignee">
                      <% if (assignedUser) { %><div class="avatar small"><img src="<%= avatarUrl(assignedUser) %>" alt="" onerror="this.dataset.fallback='';this.removeAttribute('src')" /><span><%= (assignedUser.displayName || assignedUser.username || "?").slice(0,1).toUpperCase() %></span></div><% } %>
                      <div class="role-assignee-copy">
                        <% if (assignedUser) { %><strong><%= assignedUser.displayName || assignedUser.username %></strong><span>@<%= assignedUser.username %> · Discord <%= assignment.discordId %></span>
                        <% } else { %><strong>Awaiting first Discord sign-in</strong><span>Discord ID <%= assignment.discordId %></span><% } %>
                        <span>Assigned role: <%= assignment.role %></span>
                      </div>
                    </div>
                    <form class="role-form" method="POST" action="/moderation/roles">
                      <input type="hidden" name="discordId" value="<%= assignment.discordId %>" />
                      <select class="role-select" name="role" aria-label="Change pending role for Discord ID <%= assignment.discordId %>">
                        <option value="user">Remove role</option>
                        <option value="moderator" <%= assignment.role === "moderator" ? "selected" : "" %>>Moderator</option>
                        <% if (user.role === "owner") { %><option value="manager" <%= assignment.role === "manager" ? "selected" : "" %>>Manager</option><option value="owner" <%= assignment.role === "owner" ? "selected" : "" %>>Owner</option><% } %>
                      </select>
                      <button class="role-button">Save</button>
                    </form>
                  </div>
                <% }) %>
              <% } %>
            </section>
          <% } %>
          <% if (["owner","manager"].includes(user.role)) { %>
            <section class="mod-card">
              <div class="mod-section-title"><h2>Partner badges</h2><small>Managers and owners</small></div>
              <p class="rail-note">Look up an existing account by Discord ID to grant or remove its independent partner emblem. You cannot change your own badge.</p>
              <div class="partner-badge-tools">
                <label for="partnerDiscordId">Discord user ID
                  <input id="partnerDiscordId" inputmode="numeric" pattern="[0-9]{17,20}" maxlength="20" autocomplete="off" placeholder="17–20 digit Discord ID" />
                </label>
                <div class="partner-lookup-result" id="partnerLookupResult" role="status" aria-live="polite" hidden></div>
              </div>
            </section>
          <% } %>
          <% if (["owner","manager","moderator"].includes(user.role)) { %>
            <section class="mod-card">
              <div class="mod-section-title"><h2>Active mutes</h2><small><%= activeMutes.length %> accounts</small></div>
              <form class="mod-filter-form" method="GET" action="/app"><input type="hidden" name="tab" value="moderation" /><input name="muteQ" value="<%= muteQuery %>" placeholder="Filter by name, handle, or Discord ID" aria-label="Filter active mutes" /><button type="submit">Search</button></form>
              <% if (!activeMutes.length) { %><div class="empty-small">There are no active mutes.</div><% } %>
              <% activeMutes.forEach((target) => { const muteActor = muteActorMap && muteActorMap[String(target.mutedBy)]; const targetRank = ({ user: 0, moderator: 1, manager: 2, owner: 3 })[target.role] ?? 0; const actorRank = ({ user: 0, moderator: 1, manager: 2, owner: 3 })[user.role] ?? 0; %>
                <div class="mod-user">
                  <div>
                    <div class="mod-user-name"><%= target.displayName || target.username %> · @<%= target.handle || "no-handle" %></div>
                    <div class="active-mute-meta">Reason: <%= target.mutedReason || "No reason supplied." %><br />
                      Muted by <%= muteActor ? muteActor.displayName || muteActor.username : "staff" %> ·
                      <% if (target.mutedUntil) { %>Expires <time class="local-time" datetime="<%= new Date(target.mutedUntil).toISOString() %>"><%= new Date(target.mutedUntil).toISOString() %></time> · <span class="mute-countdown" data-until="<%= new Date(target.mutedUntil).toISOString() %>"></span><% } else { %>Permanent<% } %>
                    </div>
                  </div>
                  <% if (actorRank > targetRank && String(target._id) !== String(user._id) && target.discordId !== defaultOwnerDiscordId) { %><form method="POST" action="/moderation/users/<%= target._id %>/unmute"><button class="mod-button">Unmute</button></form><% } %>
                </div>
              <% }) %>
            </section>
          <% } %>
          <section class="mod-card">
            <div class="mod-section-title"><h2>Staff and accounts</h2><small><%= staffUsers.length %> accounts</small></div>
            <% staffUsers.forEach((target) => { %>
              <div class="mod-user staff-account">
                <div class="staff-account-info"><div class="mod-user-name"><%= target.displayName %> · @<%= target.handle || "no-handle" %></div><div class="mod-user-meta">Discord <%= target.discordId %> · Role: <%= target.role %><%= target.muted ? " · Muted" : "" %><%= target.terminated ? " · Terminated" : "" %></div></div>
                <% if (!target.terminated && String(target._id) !== String(user._id) && target.discordId !== defaultOwnerDiscordId) { %>
                  <div class="staff-account-actions">
                    <% const targetRank = ({ user: 0, moderator: 1, manager: 2, owner: 3 })[target.role] ?? 0; const actorRank = ({ user: 0, moderator: 1, manager: 2, owner: 3 })[user.role] ?? 0; %>
                    <% if (["owner","manager"].includes(user.role) && (user.role === "owner" || ["user","moderator"].includes(target.role))) { %>
                      <div class="staff-action-group">
                        <span class="staff-action-label">Role</span>
                        <form class="role-form staff-role-form" method="POST" action="/moderation/roles">
                          <input type="hidden" name="discordId" value="<%= target.discordId %>" />
                          <select class="role-select" name="role" aria-label="Set role for Discord ID <%= target.discordId %>">
                            <option value="user" <%= target.role === "user" ? "selected" : "" %>>User</option>
                            <option value="moderator" <%= target.role === "moderator" ? "selected" : "" %>>Moderator</option>
                            <% if (user.role === "owner") { %><option value="manager" <%= target.role === "manager" ? "selected" : "" %>>Manager</option><option value="owner" <%= target.role === "owner" ? "selected" : "" %>>Owner</option><% } %>
                          </select>
                          <button class="role-button">Save role</button>
                        </form>
                      </div>
                    <% } %>
                    <% if (actorRank > targetRank) { %>
                      <% if (target.muted) { %>
                        <div class="staff-action-group">
                          <span class="staff-action-label">Mute</span>
                          <form method="POST" action="/moderation/users/<%= target._id %>/unmute"><button class="mod-button">Unmute account</button></form>
                        </div>
                      <% } else { %>
                        <div class="staff-action-group">
                          <span class="staff-action-label">Mute</span>
                          <form method="POST" action="/moderation/users/<%= target._id %>/mute" class="mute-form staff-mute-form">
                            <select name="duration" aria-label="Mute duration"><option value="10m">10 minutes</option><option value="1h">1 hour</option><option value="24h">24 hours</option><option value="7d">7 days</option><option value="permanent">Permanent</option></select>
                            <input name="reason" maxlength="300" placeholder="Optional reason" aria-label="Mute reason" />
                            <button class="mod-button">Apply mute</button>
                          </form>
                        </div>
                      <% } %>
                    <% } %>
                    <% if (["owner","manager"].includes(user.role) && (user.role === "owner" || ["user","moderator"].includes(target.role))) { %>
                      <div class="staff-action-group">
                        <span class="staff-action-label">Account</span>
                        <form method="POST" action="/moderation/users/<%= target._id %>/terminate" class="confirm-action staff-terminate-form" data-confirm-title="Terminate this account?" data-confirm-message="The account will be disabled and its posts hidden. Its profile, content, and ban record will be retained and can be restored from Banland."><input class="field termination-reason" name="reason" maxlength="500" placeholder="Optional reason" aria-label="Termination reason" /><button class="mod-button danger">Terminate account</button></form>
                      </div>
                    <% } %>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </section>
        <% } %>

        <% if (activeTab === "banland" && ["manager","owner"].includes(user.role)) { %>
          <div class="feed-heading"><h1>Banland</h1><p>Terminated accounts are retained here. Reinstating an account restores access and makes its retained posts visible again.</p></div>
          <nav class="profile-tabs" aria-label="Moderation tools"><a class="profile-tab" href="/app?tab=moderation">Moderation</a><a class="profile-tab" href="/app?tab=logs">Logs</a><a class="profile-tab active" href="/app?tab=banland">Banland</a></nav>
          <section class="mod-card">
            <div class="mod-section-title"><h2>Terminated accounts</h2><small><%= terminatedUsers.length %> listed</small></div>
            <form class="mod-filter-form" method="GET" action="/app"><input type="hidden" name="tab" value="banland" /><input name="banQ" value="<%= safeBanlandQuery %>" placeholder="Filter by name, handle, ID, or reason" aria-label="Filter terminated accounts" /><button type="submit">Search</button></form>
            <% if (!terminatedUsers.length) { %><div class="empty-small">No terminated accounts.</div><% } %>
            <% terminatedUsers.forEach((target) => { const terminationActor = terminationActorMap && terminationActorMap[String(target.terminatedBy)]; %>
              <div class="mod-user">
                <div>
                  <div class="mod-user-name"><%= target.displayName %> · @<%= target.handle || "no-handle" %></div>
                  <% if (target.dataPurged) { %><div class="mod-user-meta">Account data purged after the 30-day retention period · identity and handle reservation retained</div>
                  <% } else { %><div class="mod-user-meta">Discord <%= target.discordId %><%= target.role ? " · Role: " + target.role : "" %></div><% } %>
                  <div class="terminated-meta">
                    <strong>Reason:</strong> <%= target.terminationReason || "No reason recorded." %><br />
                    <strong>Terminated:</strong> <% if (target.terminatedAt) { %><time class="local-time" datetime="<%= new Date(target.terminatedAt).toISOString() %>"><%= new Date(target.terminatedAt).toISOString() %></time><% } else { %>Date unavailable<% } %><br />
                    <strong>By:</strong> <%= terminationActor ? terminationActor.displayName || terminationActor.username : target.terminatedBy ? "Staff account " + target.terminatedBy : "Staff identity unavailable" %><br />
                    <% if (target.appealStatus) { %><strong>Appeal history:</strong> <%= target.appealStatus %><% if (target.appealSubmittedAt) { %> · submitted <time class="local-time" datetime="<%= new Date(target.appealSubmittedAt).toISOString() %>"><%= new Date(target.appealSubmittedAt).toISOString() %></time><% } %><% if (target.appealDecisionAt) { %> · decided <time class="local-time" datetime="<%= new Date(target.appealDecisionAt).toISOString() %>"><%= new Date(target.appealDecisionAt).toISOString() %></time><% } %><br /><% } %>
                    <% if (target.dataPurged) { %><strong>Status:</strong> 30 days have passed. This account cannot be reinstated.<% } else if (target.reinstatementExpired) { %><strong>Status:</strong> 30 days have passed. Reinstatement is unavailable; account data is scheduled for purge.<% } else if (!target.canReinstate) { %><strong>Status:</strong> Reinstatement is unavailable because no valid termination date is recorded.<% } %>
                  </div>
                </div>
                <div class="banland-actions">
                  <% if (target.canReinstate) { %>
                    <form method="POST" action="/moderation/users/<%= target._id %>/unban" class="confirm-action" data-confirm-title="Reinstate this account?" data-confirm-message="This restores sign-in access and unhides the account’s retained posts. The termination record remains available for audit.">
                      <button class="unban-button">Reinstate account</button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </section>
        <% } %>

        <% if (activeTab === "logs" && ["moderator","manager","owner"].includes(user.role)) { %>
          <div class="feed-heading"><h1>Moderation logs</h1><p>Staff actions are retained for review. Timestamps are shown in your browser’s local timezone.</p></div>
          <nav class="profile-tabs" aria-label="Moderation tools"><a class="profile-tab" href="/app?tab=moderation">Moderation</a><a class="profile-tab active" href="/app?tab=logs">Logs</a><% if (["manager","owner"].includes(user.role)) { %><a class="profile-tab" href="/app?tab=banland">Banland</a><% } %></nav>
          <section class="mod-card">
            <form class="mod-filter-form" method="GET" action="/app"><input type="hidden" name="tab" value="logs" /><input name="logQ" value="<%= logQuery %>" placeholder="Filter by action, staff, account, or details" aria-label="Filter moderation logs" /><button type="submit">Search</button></form>
            <% if (!auditLogs.length) { %><div class="empty-small">No moderation activity matches this filter.</div><% } %>
            <div class="audit-list">
              <% auditLogs.forEach((entry) => { const actor = auditActorMap[String(entry.actorId)]; const target = auditTargetMap[String(entry.targetId)]; const actorLabel = actor ? actor.displayName || actor.username : "Staff account"; const targetLabel = target ? `${target.displayName || target.username}${target.handle ? " · @" + target.handle : ""}` : entry.targetId === "global" ? "Site settings" : entry.targetId ? `Account ${entry.targetId}` : "Not recorded"; %>
                <article class="audit-entry">
                  <div class="audit-entry-head"><strong><%= entry.action.replace(/_/g, " ").replace(/\b\w/g, (letter) => letter.toUpperCase()) %></strong><time class="local-time" datetime="<%= new Date(entry.createdAt).toISOString() %>"><%= new Date(entry.createdAt).toISOString() %></time></div>
                  <div class="audit-entry-meta">By <strong><%= actorLabel %></strong><% if (actor && actor.handle) { %> · @<%= actor.handle %><% } %><br />Target: <%= targetLabel %></div>
                  <% if (entry.details) { %><div class="audit-entry-details"><%= entry.details %></div><% } %>
                </article>
              <% }) %>
            </div>
            <% if (auditTotalPages > 1) { %><nav class="audit-pagination" aria-label="Moderation log pages"><% if (logPage > 1) { %><a href="/app?tab=logs&logQ=<%= encodeURIComponent(logQuery) %>&logPage=<%= logPage - 1 %>">← Newer</a><% } else { %><span></span><% } %><span>Page <%= logPage %> of <%= auditTotalPages %></span><% if (logPage < auditTotalPages) { %><a href="/app?tab=logs&logQ=<%= encodeURIComponent(logQuery) %>&logPage=<%= logPage + 1 %>">Older →</a><% } else { %><span></span><% } %></nav><% } %>
          </section>
        <% } %>

        <% if (activeTab === "messages") { %>
          <div class="feed-heading"><h1>Messages</h1><p>Send someone on Chirpy a note by handle.</p></div>
          <div class="message-list">
            <% messages.forEach((message) => { const mine = String(message.senderId) === String(user._id); const otherId = mine ? message.recipientId : message.senderId; const other = messageUserMap[String(otherId)]; %>
              <div class="message-bubble <%= mine ? 'mine' : '' %>"><small><%= mine ? "You to" : "From" %> @<%= other ? other.handle || other.displayName : "deleted account" %></small><%= message.text %></div>
            <% }) %>
            <% if (!messages.length) { %><div class="empty"><strong>Your messages</strong>Messages you send or receive will show here.</div><% } %>
          </div>
          <form class="message-form" method="POST" action="/messages"><input name="handle" placeholder="Recipient handle" required /><textarea name="text" maxlength="1000" placeholder="Write a message…" required></textarea><button class="post-submit">Send message</button></form>
        <% } %>

        <% if (activeTab === "notifications") { %>
          <div class="feed-heading"><h1>Notifications</h1><p>Follows and activity on posts you authored or were mentioned in.</p></div>
          <div class="notification-list">
            <% notifications.forEach((notification) => {
              const actor = notificationActorMap[String(notification.actorId)] || null;
              const actorName = actor ? actor.displayName || actor.username : "A Chirpy member";
              const notificationCopy = ({
                follow: "started following you",
                mention: "mentioned you in a post",
                comment: "commented on your post",
                like: "liked your post",
                repost: "reposted your post",
                message: "sent you a message",
              })[notification.type] || "interacted with you";
              const notificationHref = notification.type === "follow" && actor && actor.handle
                ? `/profile/${encodeURIComponent(actor.handle)}`
                : notification.type === "message"
                  ? "/app?tab=messages"
                : notification.postId
                  ? `/app#${notification.postId}`
                  : "/app?tab=notifications";
            %>
              <a class="notification-card <%= notification.unread ? "unread" : "" %>" href="<%= notificationHref %>">
                <div class="avatar"><% if (actor) { %><img src="<%= avatarUrl(actor) %>" alt="" onerror="this.removeAttribute('src')" /><% } %><span><%= actorName.slice(0,1).toUpperCase() %></span></div>
                <span><strong><%= actorName %><%- renderPartnerBadge(actor) %></strong> <%= notificationCopy %> · <time class="local-time" datetime="<%= new Date(notification.createdAt).toISOString() %>"><%= new Date(notification.createdAt).toISOString() %></time></span>
              </a>
            <% }) %>
            <% if (!notifications.length) { %><div class="empty"><strong>No notifications yet</strong>New followers and activity on your posts will show up here.</div><% } %>
          </div>
        <% } %>

        <% if (activeTab === "bookmarks") { %><div class="feed-heading"><h1>Bookmarks</h1><p>Posts you’ve saved for later.</p></div><% } %>
        <% if (activeTab === "explore" && query) { %><div class="feed-heading"><h1>Search</h1><p>Results for “<%= query %>”</p></div><% } %>

        <% if (["home","explore","bookmarks","profile"].includes(activeTab)) { %>
          <% if (!posts.length) { %><div class="empty"><strong><%= activeTab === "profile" && profileView === "reposts" ? "No reposts yet" : activeTab === "profile" ? "No posts yet" : activeTab === "bookmarks" ? "Nothing saved yet" : "No posts found" %></strong><%= activeTab === "profile" && profileView === "reposts" ? "Posts you repost will show here." : activeTab === "bookmarks" ? "Bookmark a post to save it here." : "Try another search or be the first to post." %></div><% } %>

          <% posts.forEach((post) => { const authorIdValue = post.authorId && post.authorId._id ? post.authorId._id : post.authorId; const authorId = String(authorIdValue && typeof authorIdValue.toHexString === "function" ? authorIdValue.toHexString() : authorIdValue || "").toLowerCase(); const author = post.author || userMap[authorId] || Object.values(userMap).find((entry) => String(entry._id && typeof entry._id.toHexString === "function" ? entry._id.toHexString() : entry._id || "").toLowerCase() === authorId); const authorName = author ? author.displayName || author.username : "Chirpy member"; const authorHandle = author ? author.handle || author.username : `member_${authorId.slice(-6)}`; const authorRole = author ? author.role : "user"; const verified = author && author.verificationStatus === "verified"; const isOwnPost = author && String(author._id) === String(user._id); const canStaffManagePost = ["moderator","manager","owner"].includes(user.role); const liked = (post.likes || []).some((id) => String(id) === String(user._id)); const reposted = (post.reposts || []).some((id) => String(id) === String(user._id)); const bookmarked = (post.bookmarks || []).some((id) => String(id) === String(user._id)); const postImage = post.imageMime ? `/posts/${post._id}/image` : ""; %>
            <article class="post" id="<%= post._id %>">
              <% const postPollVotes = post.poll && post.poll.votes || []; const userPollVote = postPollVotes.find((vote) => String(vote.userId) === String(user._id)); const pollVoteCounts = post.poll ? post.poll.options.map((option, index) => postPollVotes.filter((vote) => vote.optionIndex === index).length) : []; const pollTotalVotes = pollVoteCounts.reduce((total, count) => total + count, 0); %>
              <% if (activeTab === "profile" && profileView === "reposts") { %><div class="repost-note">↻ You reposted</div><% } %>
              <header class="post-header">
                <a class="avatar profile-avatar-link" href="/profile/<%= encodeURIComponent(authorHandle) %>" aria-label="View @<%= authorHandle %>'s profile"><% if (author) { %><img src="<%= avatarUrl(author) %>" alt="" onerror="this.dataset.fallback='';this.removeAttribute('src')" /><% } %><span><%= authorName.slice(0,1).toUpperCase() %></span></a>
                <div class="post-author"><div class="author-line">
                  <a class="author-name" href="/profile/<%= encodeURIComponent(authorHandle) %>"><%= authorName %><%- renderPartnerBadge(author) %>
                    <% if (authorRole === "owner") { %><span class="badge owner" role="img" aria-label="Owner" title="Owner"><svg aria-hidden="true"><use href="#i-crown"/></svg></span>
                    <% } else if (authorRole === "manager") { %><span class="badge manager" role="img" aria-label="Management" title="Management"><svg aria-hidden="true"><use href="#i-hammer"/></svg></span>
                    <% } else if (authorRole === "moderator") { %><span class="badge moderator" role="img" aria-label="Moderator" title="Moderator"><svg aria-hidden="true"><use href="#i-shield"/></svg></span><% } %>
                    <% if (["owner","manager","moderator"].includes(authorRole) || verified) { %><span class="badge <%= verified ? "verified" : "staff-check" %>" role="img" aria-label="<%= verified ? "Verified" : "Staff" %>" title="<%= verified ? "Verified" : "Staff" %>"><svg aria-hidden="true"><use href="#i-verified"/></svg></span><% } %>
                  </a>
                  <a class="author-handle" href="/profile/<%= encodeURIComponent(authorHandle) %>">@<%= authorHandle %></a>
                  <time class="timestamp local-time" datetime="<%= new Date(post.createdAt).toISOString() %>"><%= new Date(post.createdAt).toISOString() %></time>
                </div></div>
                <% if (isOwnPost || canStaffManagePost) { %>
                  <div class="post-menu">
                    <button class="post-menu-trigger" type="button" aria-label="Post actions" aria-expanded="false" aria-controls="post-menu-<%= post._id %>">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg>
                    </button>
                    <div class="post-menu-panel" id="post-menu-<%= post._id %>" role="region" aria-label="Actions for post by <%= authorName %>" hidden>
                      <% if (isOwnPost) { %>
                        <section class="post-menu-section" aria-label="Your post actions">
                          <h3>Your post</h3>
                          <button type="button" class="edit-post-trigger" data-post-id="<%= post._id %>" data-post-text="<%= post.text %>">Edit post text</button>
                          <form method="POST" action="/posts/<%= post._id %>/delete" class="confirm-action" data-confirm-title="Delete your post?" data-confirm-message="This post will be removed from active feeds. Its record is retained for service integrity."><button type="submit" class="danger">Delete your post</button></form>
                        </section>
                      <% } %>
                      <% if (canStaffManagePost && !isOwnPost) { %>
                        <section class="post-menu-section" aria-label="Staff moderation actions">
                          <h3>Moderation</h3>
                          <% if (!isOwnPost) { %><form method="POST" action="/moderation/posts/<%= post._id %>/delete" class="confirm-action" data-confirm-title="Delete this post?" data-confirm-message="This post will be removed from the feed. This action cannot be undone."><button type="submit" class="danger">Delete post</button></form><% } %>
                        <% if (author && !isOwnPost && author.discordId !== defaultOwnerDiscordId && (({ user: 0, moderator: 1, manager: 2, owner: 3 })[user.role] ?? 0) > (({ user: 0, moderator: 1, manager: 2, owner: 3 })[author.role] ?? 0)) { %>
                          <% if (author.muted) { %><form method="POST" action="/moderation/users/<%= author._id %>/unmute"><button>Unmute user @<%= authorHandle %></button></form><% } else { %>
                            <form method="POST" action="/moderation/users/<%= author._id %>/mute">
                              <label class="menu-field-label" for="post-mute-duration-<%= post._id %>">Mute duration</label>
                              <select id="post-mute-duration-<%= post._id %>" name="duration" aria-label="Mute duration"><option value="10m">10 minutes</option><option value="1h">1 hour</option><option value="24h">24 hours</option><option value="7d">7 days</option><option value="permanent">Permanent</option></select>
                              <label class="menu-field-label" for="post-mute-reason-<%= post._id %>">Reason (optional)</label>
                              <input id="post-mute-reason-<%= post._id %>" name="reason" maxlength="300" placeholder="Add a reason" />
                              <button type="submit">Mute @<%= authorHandle %></button>
                            </form>
                          <% } %>
                        <% } %>
                        <% if (!isOwnPost && ["owner","manager"].includes(user.role) && author && (user.role === "owner" || ["user","moderator"].includes(author.role))) { %>
                          <form method="POST" action="/moderation/users/<%= author._id %>/terminate" class="confirm-action" data-confirm-title="Terminate this account?" data-confirm-message="The account will be disabled and its posts hidden. Its profile, content, and ban record will be retained and can be restored from Banland.">
                            <label class="menu-field-label" for="post-termination-reason-<%= post._id %>">Termination reason (optional)</label>
                            <input id="post-termination-reason-<%= post._id %>" name="reason" maxlength="500" placeholder="Add a reason" />
                            <button type="submit" class="danger">Terminate account</button>
                          </form>
                        <% } %>
                        </section>
                      <% } %>
                    </div>
                  </div>
                <% } %>
              </header>
              <% if (post.text) { %><div class="post-body"><%= post.text %></div><% } %>
              <% if (postImage) { %><button type="button" class="post-image-button" data-image-src="<%= postImage %>" aria-label="Open post image"><img class="post-image" src="<%= postImage %>" alt="Post attachment; activate to view larger" loading="lazy" decoding="async" /><span class="image-load-fallback" hidden>Image unavailable</span></button><% } %>
              <% if (post.poll) { %>
                <section class="poll-card" data-poll-id="<%= post._id %>">
                  <div class="poll-question"><strong><%= post.poll.question %></strong><span><%= pollTotalVotes %> <%= pollTotalVotes === 1 ? "vote" : "votes" %></span></div>
                  <div class="poll-options">
                    <% post.poll.options.forEach((option, index) => { const voteCount = pollVoteCounts[index]; const percentage = pollTotalVotes ? Math.round(voteCount / pollTotalVotes * 100) : 0; %>
                      <button type="button" class="poll-option-button <%= userPollVote && userPollVote.optionIndex === index ? "selected" : "" %>" data-poll-option="<%= index %>" aria-pressed="<%= Boolean(userPollVote && userPollVote.optionIndex === index) %>">
                        <progress class="poll-option-fill" max="100" value="<%= percentage %>" aria-label="<%= option.text %>: <%= percentage %> percent"><%= percentage %>%</progress>
                        <span class="poll-option-label"><%= option.text %></span>
                        <span class="poll-option-result"><%= percentage %>% · <%= voteCount %></span>
                      </button>
                    <% }) %>
                  </div>
                  <div class="poll-footnote"><%= userPollVote ? "Your vote is saved. You can change it." : "Choose an option to vote." %></div>
                </section>
              <% } %>
              <div class="post-actions">
                <button class="icon-btn comment-toggle" type="button" aria-label="Comment"><svg><use href="#i-comment"/></svg><span><%= post.comments.length || "" %></span></button>
                <button class="icon-btn action-btn <%= reposted ? 'reposted' : '' %>" type="button" data-action="repost" data-id="<%= post._id %>" aria-label="Repost"><svg><use href="#i-repost"/></svg><span><%= post.reposts.length || "" %></span></button>
                <button class="icon-btn action-btn <%= liked ? 'liked' : '' %>" type="button" data-action="like" data-id="<%= post._id %>" aria-label="Like"><svg><use href="#i-heart"/></svg><span><%= post.likes.length || "" %></span></button>
                <button class="icon-btn action-btn <%= bookmarked ? 'bookmarked' : '' %>" type="button" data-action="bookmark" data-id="<%= post._id %>" aria-label="Bookmark"><svg><use href="#i-bookmark"/></svg></button>
                <button class="icon-btn share-btn" type="button" data-id="<%= post._id %>" aria-label="Share"><svg><use href="#i-share"/></svg></button>
              </div>
              <div class="post-interaction-error" role="alert" hidden></div>
              <div class="comment-list"><% (post.comments || []).forEach((comment) => { %><div class="comment"><strong>@<%= comment.handle %></strong><%= comment.text %></div><% }) %></div>
              <form class="comment-form" data-id="<%= post._id %>" hidden><input name="text" maxlength="300" placeholder="Write a comment…" required /><button>Reply</button></form>
            </article>
          <% }) %>
        <% } %>
      </main>

    </div>

    <dialog class="confirm-dialog" id="confirmDialog" aria-labelledby="confirmTitle" aria-describedby="confirmMessage">
      <div class="confirm-content">
        <p class="confirm-kicker">Chirpy moderation</p>
        <h2 id="confirmTitle">Confirm action</h2>
        <p id="confirmMessage"></p>
        <div class="confirm-actions">
          <button type="button" id="cancelConfirm">Cancel</button>
          <button type="button" class="confirm-danger" id="acceptConfirm">Continue</button>
        </div>
      </div>
    </dialog>
    <dialog class="confirm-dialog" id="editPostDialog" aria-labelledby="editPostTitle">
      <form class="confirm-content" id="editPostForm">
        <p class="confirm-kicker">Your post</p>
        <h2 id="editPostTitle">Edit post text</h2>
        <label class="sr-only" for="editPostText">Post text</label>
        <textarea id="editPostText" maxlength="500" rows="6" style="width:100%;margin-top:14px;padding:12px;border:1px solid #353741;border-radius:9px;background:#090a0f;color:white;resize:vertical"></textarea>
        <div class="post-interaction-error" id="editPostError" role="alert" hidden></div>
        <div class="confirm-actions"><button type="button" id="cancelEditPost">Cancel</button><button type="submit" class="confirm-danger" id="saveEditPost">Save changes</button></div>
      </form>
    </dialog>
    <dialog class="confirm-dialog" id="sessionExpiredDialog" aria-labelledby="sessionExpiredTitle" aria-describedby="sessionExpiredMessage">
      <div class="confirm-content">
        <p class="confirm-kicker">Sign-in needed</p>
        <h2 id="sessionExpiredTitle">Your session expired</h2>
        <p id="sessionExpiredMessage">This action was not applied. Sign in again to continue; we’ll return you to this page afterward.</p>
        <div class="confirm-actions"><button type="button" id="dismissSessionExpired">Not now</button><a class="auth-btn" id="sessionExpiredLogin" href="/login?error=session" style="display:inline-flex;align-items:center;padding:0 15px">Sign in</a></div>
      </div>
    </dialog>
    <% if (verificationOutcomeNotice) { %>
      <dialog class="verification-notice" id="verificationOutcomeNotice" aria-labelledby="verificationOutcomeTitle" aria-describedby="verificationOutcomeMessage">
        <div class="verification-notice-content">
          <div class="verification-notice-icon" aria-hidden="true"><%= verificationOutcomeNotice.outcome === "approved" ? "✓" : "!" %></div>
          <p class="confirm-kicker">Verification update</p>
          <h2 id="verificationOutcomeTitle"><%= verificationOutcomeNotice.outcome === "approved" ? "Your account is verified" : "Verification application update" %></h2>
          <p id="verificationOutcomeMessage"><%= verificationOutcomeNotice.outcome === "approved" ? "Your verification application was approved. The orange verified badge is now visible beside your name." : "Your verification application was not approved. If seven days have passed since submission and applications are open, you may submit another application." %></p>
          <p class="settings-error" id="verificationOutcomeError" role="alert" hidden></p>
          <button type="button" id="dismissVerificationOutcome">Understood</button>
        </div>
      </dialog>
      <script>
        const outcomeNoticeDialog = document.getElementById("verificationOutcomeNotice");
        const outcomeNoticeButton = document.getElementById("dismissVerificationOutcome");
        outcomeNoticeDialog.showModal();
        outcomeNoticeButton.addEventListener("click", async () => {
          outcomeNoticeButton.disabled = true;
          try {
            const response = await fetch("/settings/verification/outcome-seen", {
              method: "POST",
              credentials: "same-origin",
              headers: {
                "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
                Accept: "application/json",
              },
              body: new URLSearchParams({ noticeId: "<%= verificationOutcomeNotice._id %>" }),
            });
            if (response.status === 401) throw new Error("Your session expired. Sign in again to acknowledge this notice.");
            const result = await response.json();
            if (!response.ok || !result.success) throw new Error(result.message || "Could not save this notice acknowledgement.");
            outcomeNoticeDialog.close();
          } catch (error) {
            const errorElement = document.getElementById("verificationOutcomeError");
            errorElement.textContent = error.message || "Could not save this notice acknowledgement.";
            errorElement.hidden = false;
          } finally {
            outcomeNoticeButton.disabled = false;
          }
        });
      </script>
    <% } %>
    <% if (user.verificationRemovalNotice && !verificationOutcomeNotice) { %>
      <dialog class="verification-notice" id="verificationRemovalNotice" aria-labelledby="verificationNoticeTitle" aria-describedby="verificationNoticeMessage">
        <div class="verification-notice-content">
          <div class="verification-notice-icon" aria-hidden="true">✓</div>
          <p class="confirm-kicker">Account update</p>
          <h2 id="verificationNoticeTitle">Verification was removed</h2>
          <p id="verificationNoticeMessage">Your account is no longer verified, and the orange verification badge has been removed. You can submit a new verification application from Settings.</p>
          <button type="button" id="dismissVerificationNotice">Understood</button>
        </div>
      </dialog>
      <script>
        const verificationNotice = document.getElementById("verificationRemovalNotice");
        verificationNotice.showModal();
        document.getElementById("dismissVerificationNotice").addEventListener("click", () => {
          verificationNotice.close();
        });
        window.requestAnimationFrame(() => {
          if (!verificationNotice.open || document.visibilityState !== "visible") return;
          fetch("/settings/verification/notice-seen", {
            method: "POST",
            headers: { Accept: "application/json" }
          })
            .then((response) => {
              if (redirectToLoginIfNeeded(response)) return;
              if (!response.ok) throw new Error("Could not record verification notice display.");
            })
            .catch((error) => console.error(error));
        });
      </script>
    <% } %>

    <script>
      const appToast = document.getElementById("appToast");
      let toastTimer = null;
      function showToast(message) {
        if (!appToast) return;
        appToast.textContent = message;
        appToast.classList.add("visible");
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => appToast.classList.remove("visible"), 5000);
      }
      function redirectToLoginIfNeeded(response) {
        if (response.status !== 401) return false;
        const loginUrl = response.headers.get("X-Chirpy-Login-Url");
        const dialog = document.getElementById("sessionExpiredDialog");
        const loginLink = document.getElementById("sessionExpiredLogin");
        if (loginLink && loginUrl) loginLink.href = loginUrl;
        if (dialog && !dialog.open) dialog.showModal();
        else if (!dialog) showToast("Your session expired. Sign in again to continue; this action was not applied.");
        return true;
      }
      document.getElementById("dismissSessionExpired")?.addEventListener("click", () => {
        document.getElementById("sessionExpiredDialog")?.close();
      });
      if (appToast?.dataset.message) showToast(appToast.dataset.message);

      const localDateFormatter = new Intl.DateTimeFormat(undefined, {
        dateStyle: "medium",
        timeStyle: "short"
      });
      document.querySelectorAll(".local-time,.local-date").forEach((element) => {
        const date = new Date(element.dateTime);
        if (Number.isFinite(date.getTime())) {
          element.textContent = element.classList.contains("local-date")
            ? new Intl.DateTimeFormat(undefined, { dateStyle: "medium" }).format(date)
            : localDateFormatter.format(date);
        }
      });
      function updateMuteCountdowns() {
        document.querySelectorAll(".mute-countdown[data-until]").forEach((element) => {
          const remaining = new Date(element.dataset.until).getTime() - Date.now();
          if (!Number.isFinite(remaining) || remaining <= 0) {
            element.textContent = "expiring";
            return;
          }
          const totalMinutes = Math.ceil(remaining / 60000);
          const days = Math.floor(totalMinutes / 1440);
          const hours = Math.floor((totalMinutes % 1440) / 60);
          const minutes = totalMinutes % 60;
          element.textContent = days ? `${days}d ${hours}h remaining` : hours ? `${hours}h ${minutes}m remaining` : `${minutes}m remaining`;
        });
      }
      updateMuteCountdowns();
      window.setInterval(updateMuteCountdowns, 60000);

      const confirmDialog = document.getElementById("confirmDialog");
      const confirmTitle = document.getElementById("confirmTitle");
      const confirmMessage = document.getElementById("confirmMessage");
      const cancelConfirm = document.getElementById("cancelConfirm");
      const acceptConfirm = document.getElementById("acceptConfirm");
      let pendingConfirmForm = null;
      let confirmedForm = null;
      let confirmedSubmitter = null;
      const postMenuStates = [...document.querySelectorAll(".post-menu")].map((menu) => ({
        menu,
        trigger: menu.querySelector(".post-menu-trigger"),
        panel: menu.querySelector(".post-menu-panel"),
        closeTimer: null
      }));
      function closePostMenu(state, returnFocus = false) {
        window.clearTimeout(state.closeTimer);
        state.panel.classList.remove("is-open");
        state.panel.hidden = true;
        state.menu.append(state.panel);
        state.panel.style.removeProperty("left");
        state.panel.style.removeProperty("top");
        state.trigger.setAttribute("aria-expanded", "false");
        if (returnFocus) state.trigger.focus();
      }
      function closeAllPostMenus(except = null) {
        postMenuStates.forEach((state) => {
          if (state !== except && !state.panel.hidden) closePostMenu(state);
        });
      }
      function openPostMenu(state) {
        closeAllPostMenus(state);
        window.clearTimeout(state.closeTimer);
        state.panel.hidden = false;
        state.panel.classList.remove("is-open");
        state.trigger.setAttribute("aria-expanded", "true");
        document.body.append(state.panel);

        const triggerRect = state.trigger.getBoundingClientRect();
        const panelRect = state.panel.getBoundingClientRect();
        const edge = 12;
        const left = Math.max(edge, Math.min(
          triggerRect.right - panelRect.width,
          window.innerWidth - panelRect.width - edge
        ));
        const belowTop = triggerRect.bottom + 7;
        const top = belowTop + panelRect.height <= window.innerHeight - edge
          ? belowTop
          : Math.max(edge, triggerRect.top - panelRect.height - 7);
        state.panel.style.left = `${left}px`;
        state.panel.style.top = `${top}px`;
        window.requestAnimationFrame(() => {
          if (!state.panel.hidden) state.panel.classList.add("is-open");
        });
        const firstControl = state.panel.querySelector("button:not(:disabled),input:not(:disabled),select:not(:disabled),a[href]");
        if (firstControl) firstControl.focus();
      }

      postMenuStates.forEach((state) => {
        state.trigger.addEventListener("click", () => {
          if (state.panel.hidden) openPostMenu(state);
          else {
            closePostMenu(state);
            state.trigger.focus();
          }
        });
        state.panel.addEventListener("click", (event) => event.stopPropagation());
        state.panel.addEventListener("keydown", (event) => {
          if (event.key !== "Tab") return;
          const focusable = [...state.panel.querySelectorAll("button:not(:disabled),input:not(:disabled),select:not(:disabled),a[href]")];
          if (!focusable.length) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        });
      });
      document.addEventListener("click", (event) => {
        postMenuStates.forEach((state) => {
          if (
            !state.panel.hidden &&
            !state.menu.contains(event.target) &&
            !state.panel.contains(event.target)
          ) closePostMenu(state);
        });
      });
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        const state = postMenuStates.find((item) => !item.panel.hidden);
        if (state) {
          event.preventDefault();
          closePostMenu(state, true);
        }
      });
      window.addEventListener("resize", () => closeAllPostMenus());
      window.addEventListener("scroll", () => closeAllPostMenus(), { passive: true, capture: true });

      document.querySelectorAll(".confirm-action").forEach((form) => {
        form.addEventListener("submit", (event) => {
          if (confirmedForm === form) {
            confirmedForm = null;
            return;
          }
          event.preventDefault();
          closeAllPostMenus();
          pendingConfirmForm = form;
          confirmedSubmitter = event.submitter || form.querySelector("button[type='submit'],button:not([type])");
          confirmTitle.textContent = form.dataset.confirmTitle || "Confirm action";
          confirmMessage.textContent = form.dataset.confirmMessage || "Are you sure you want to continue?";
          confirmDialog.showModal();
          cancelConfirm.focus();
        });
      });

      cancelConfirm.addEventListener("click", () => confirmDialog.close());
      acceptConfirm.addEventListener("click", () => {
        if (!pendingConfirmForm) return;
        confirmedForm = pendingConfirmForm;
        const form = pendingConfirmForm;
        const submitter = confirmedSubmitter;
        pendingConfirmForm = null;
        confirmedSubmitter = null;
        confirmDialog.close();
        if (submitter) form.requestSubmit(submitter);
        else form.requestSubmit();
      });
      confirmDialog.addEventListener("close", () => {
        pendingConfirmForm = null;
        confirmedSubmitter = null;
      });

      const composer = document.getElementById("composer");
      const openComposer = document.getElementById("openComposer");
      if (openComposer && composer) {
        openComposer.addEventListener("click", () => {
          composer.hidden = false;
          composer.querySelector("textarea").focus();
          composer.scrollIntoView({ behavior: "smooth", block: "center" });
        });
      }

      const roleIdInput = document.querySelector("#roleAssignmentPreview")?.previousElementSibling;
      const roleAssignmentPreview = document.getElementById("roleAssignmentPreview");
      if (roleIdInput && roleAssignmentPreview) {
        let roleLookupTimer = null;
        let roleLookupRequest = 0;
        let roleLookupController = null;
        roleIdInput.addEventListener("input", () => {
          window.clearTimeout(roleLookupTimer);
          if (roleLookupController) roleLookupController.abort();
          const requestId = ++roleLookupRequest;
          const discordId = roleIdInput.value.trim();
          roleAssignmentPreview.replaceChildren();
          roleAssignmentPreview.hidden = false;

          if (!/^\d{17,20}$/.test(discordId)) {
            roleAssignmentPreview.textContent = discordId
              ? "Enter a complete 17–20 digit Discord ID to check for an existing Chirpy profile."
              : "";
            roleAssignmentPreview.hidden = !discordId;
            return;
          }

          roleAssignmentPreview.textContent = "Checking for an existing Chirpy profile…";
          roleLookupTimer = window.setTimeout(async () => {
            roleLookupController = new AbortController();
            try {
              const response = await fetch(
                `/moderation/roles/lookup?discordId=${encodeURIComponent(discordId)}`,
                {
                  signal: roleLookupController.signal,
                  cache: "no-store",
                  headers: { Accept: "application/json" }
                }
              );
              const result = await response.json();
              if (requestId !== roleLookupRequest) return;
              if (!response.ok) {
                throw new Error(result.message || "Profile lookup failed.");
              }

              roleAssignmentPreview.replaceChildren();
              if (result.found) {
                const avatar = document.createElement("div");
                avatar.className = "avatar small";
                const image = document.createElement("img");
                image.src = result.account.avatarUrl;
                image.alt = "";
                image.onerror = () => {
                  image.dataset.fallback = "";
                  image.removeAttribute("src");
                };
                const initial = document.createElement("span");
                initial.textContent = (result.account.displayName || "?").slice(0, 1).toUpperCase();
                avatar.append(image, initial);
                const copy = document.createElement("span");
                copy.textContent = `${result.account.displayName} · @${result.account.username}${result.account.handle ? ` · @${result.account.handle}` : ""}${result.account.terminated ? " · account terminated; assignment unavailable" : ""}`;
                roleAssignmentPreview.append(avatar, copy);
              } else {
                roleAssignmentPreview.textContent = result.message;
              }
            } catch (lookupError) {
              if (lookupError.name !== "AbortError" && requestId === roleLookupRequest) {
                roleAssignmentPreview.textContent = lookupError.message || "Could not check this Discord ID.";
              }
            }
          }, 250);
        });
      }

      const partnerDiscordIdInput = document.getElementById("partnerDiscordId");
      const partnerLookupResult = document.getElementById("partnerLookupResult");
      if (partnerDiscordIdInput && partnerLookupResult) {
        let partnerLookupTimer = null;
        let partnerLookupRequest = 0;
        let partnerLookupController = null;

        partnerDiscordIdInput.addEventListener("input", () => {
          window.clearTimeout(partnerLookupTimer);
          if (partnerLookupController) partnerLookupController.abort();
          const requestId = ++partnerLookupRequest;
          const discordId = partnerDiscordIdInput.value.trim();
          partnerLookupResult.replaceChildren();
          partnerLookupResult.hidden = Boolean(!discordId);
          if (!discordId) return;
          if (!/^\d{17,20}$/.test(discordId)) {
            partnerLookupResult.textContent = "Enter a complete 17–20 digit Discord ID.";
            return;
          }

          partnerLookupResult.textContent = "Looking up the existing account…";
          partnerLookupTimer = window.setTimeout(async () => {
            partnerLookupController = new AbortController();
            try {
              const response = await fetch(
                `/moderation/roles/lookup?discordId=${encodeURIComponent(discordId)}`,
                {
                  signal: partnerLookupController.signal,
                  cache: "no-store",
                  headers: { Accept: "application/json" },
                }
              );
              const result = await response.json();
              if (requestId !== partnerLookupRequest) return;
              if (!response.ok) throw new Error(result.message || "Account lookup failed.");

              partnerLookupResult.replaceChildren();
              if (!result.found) {
                partnerLookupResult.textContent = result.message || "No existing Chirpy account was found.";
                return;
              }

              const account = result.account;
              const summary = document.createElement("span");
              summary.className = "partner-status";
              summary.textContent = `${account.displayName} · @${account.handle || account.username} · ${account.partner ? "Partner badge on" : "Partner badge off"}${account.terminated ? " · account terminated" : ""}`;
              partnerLookupResult.append(summary);

              if (account.partner) {
                const emblem = document.createElement("span");
                emblem.className = "badge partner";
                emblem.setAttribute("role", "img");
                emblem.setAttribute("aria-label", "Partner");
                emblem.title = "Partner";
                emblem.innerHTML = '<svg aria-hidden="true"><use href="#i-partner"></use></svg>';
                partnerLookupResult.append(emblem);
              }

              if (account.terminated || account.isSelf) {
                const unavailable = document.createElement("span");
                unavailable.className = "partner-status";
                unavailable.textContent = account.isSelf
                  ? "You cannot change your own partner badge."
                  : "Partner badges can only be managed for active accounts.";
                partnerLookupResult.append(unavailable);
                return;
              }

              const form = document.createElement("form");
              form.method = "POST";
              form.action = "/moderation/partner";
              form.setAttribute("aria-label", "Update partner badge");
              const idField = document.createElement("input");
              idField.type = "hidden";
              idField.name = "discordId";
              idField.value = discordId;
              const enabled = document.createElement("select");
              enabled.name = "enabled";
              enabled.setAttribute("aria-label", "Partner badge status");
              for (const [value, label] of [["true", "Grant partner badge"], ["false", "Remove partner badge"]]) {
                const option = document.createElement("option");
                option.value = value;
                option.textContent = label;
                option.selected = (value === "true") !== account.partner;
                enabled.append(option);
              }
              const submit = document.createElement("button");
              submit.type = "submit";
              submit.className = "role-button";
              submit.textContent = "Save partner badge";
              form.append(idField, enabled, submit);
              partnerLookupResult.append(form);
            } catch (lookupError) {
              if (lookupError.name !== "AbortError" && requestId === partnerLookupRequest) {
                partnerLookupResult.textContent = lookupError.message || "Could not look up this account.";
              }
            }
          }, 250);
        });
      }

      document.querySelectorAll(".composer").forEach((form) => {
        const pollTemplate = document.getElementById("pollComposerTemplate");
        form.insertBefore(
          pollTemplate.content.cloneNode(true),
          form.querySelector(".upload-error")
        );
        const pollToggle = form.querySelector(".poll-toggle");
        const pollEditor = form.querySelector(".poll-editor");
        pollToggle.addEventListener("click", () => {
          pollEditor.hidden = !pollEditor.hidden;
          pollToggle.setAttribute("aria-pressed", String(!pollEditor.hidden));
          pollToggle.textContent = pollEditor.hidden ? "＋ Add poll" : "− Remove poll";
        });

        const fileInput = form.querySelector(".image-upload-input");
        const preview = form.querySelector(".image-preview");
        const previewImage = preview.querySelector("img");
        const uploadName = form.querySelector(".upload-name");
        const uploadError = form.querySelector(".upload-error");
        const submitButton = form.querySelector(".post-submit");
        let selectedFile = null;
        let previewUrl = null;
        const allowedImageTypes = new Set([
          "image/png",
          "image/jpeg",
          "image/gif",
          "image/webp"
        ]);
        const showUploadError = (message) => {
          uploadError.textContent = message;
          uploadError.hidden = !message;
        };
        const clearSelectedImage = () => {
          selectedFile = null;
          fileInput.value = "";
          preview.hidden = true;
          previewImage.removeAttribute("src");
          if (previewUrl) URL.revokeObjectURL(previewUrl);
          previewUrl = null;
          uploadName.textContent = "PNG, JPG, GIF or WebP · up to 5 MB";
        };

        fileInput.addEventListener("change", () => {
          showUploadError("");
          const file = fileInput.files[0];
          if (!file) return;
          if (!allowedImageTypes.has(file.type)) {
            clearSelectedImage();
            showUploadError("Choose a PNG, JPG, GIF, or WebP image.");
            return;
          }
          if (file.size > 5 * 1024 * 1024) {
            clearSelectedImage();
            showUploadError("Images must be 5 MB or smaller.");
            return;
          }

          selectedFile = file;
          if (previewUrl) URL.revokeObjectURL(previewUrl);
          previewUrl = URL.createObjectURL(file);
          previewImage.src = previewUrl;
          preview.hidden = false;
          uploadName.textContent = file.name;
        });

        form.querySelector(".remove-image").addEventListener("click", () => {
          clearSelectedImage();
          showUploadError("");
        });

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          showUploadError("");
          submitButton.disabled = true;
          submitButton.textContent = "Posting…";

          try {
            let imageData = "";
            if (selectedFile) {
              imageData = await new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => resolve(String(reader.result || ""));
                reader.onerror = () => reject(new Error("Could not read the selected image."));
                reader.readAsDataURL(selectedFile);
              });
            }

            const payload = {
              text: form.querySelector("textarea").value,
              imageData
            };
            if (!pollEditor.hidden) {
              payload.poll = {
                question: pollEditor.querySelector(".poll-question").value,
                options: [...pollEditor.querySelectorAll(".poll-option")].map(
                  (input) => input.value
                )
              };
            }

            const response = await fetch(form.action, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload)
            });
            if (redirectToLoginIfNeeded(response)) return;
            const result = await response.json().catch(() => ({}));
            if (!response.ok) {
              throw new Error(result.message || "Could not publish the post.");
            }
            window.location.assign(result.redirect || "/app");
          } catch (error) {
            showUploadError(error.message || "Could not publish the post.");
          } finally {
            submitButton.disabled = false;
            submitButton.textContent = "Post";
          }
        });
      });

      document.querySelectorAll(".composer textarea").forEach((textarea) => {
        const counter = textarea.closest(".composer").querySelector(".char-count");
        textarea.addEventListener("input", () => {
          if (counter) counter.textContent = `${textarea.value.length}/500`;
        });
      });

      document.querySelectorAll(".action-btn").forEach((button) => {
        button.addEventListener("click", async () => {
          button.disabled = true;
          try {
            const response = await fetch(`/posts/${button.dataset.id}/${button.dataset.action}`, { method: "POST" });
            if (redirectToLoginIfNeeded(response)) return;
            const result = await response.json();
            if (!response.ok) throw new Error(result.message || "Action failed.");
            const action = button.dataset.action;
            button.classList.toggle(action === "like" ? "liked" : action === "repost" ? "reposted" : "bookmarked", result.active);
            const counter = button.querySelector("span");
            if (counter && action !== "bookmark") counter.textContent = result.count || "";
          } catch (error) {
            showToast(error.message || "That action could not be completed.");
          } finally {
            button.disabled = false;
          }
        });
      });

      document.querySelectorAll(".poll-card").forEach((poll) => {
        poll.querySelectorAll(".poll-option-button").forEach((button) => {
          button.addEventListener("click", async () => {
            const post = poll.closest(".post");
            const error = post.querySelector(".post-interaction-error");
            const buttons = [...poll.querySelectorAll(".poll-option-button")];
            error.hidden = true;
            buttons.forEach((item) => { item.disabled = true; });
            try {
              const response = await fetch(`/posts/${poll.dataset.pollId}/poll`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ optionIndex: Number(button.dataset.pollOption) })
              });
              if (redirectToLoginIfNeeded(response)) return;
              const responseText = await response.text();
              let result;
              try {
                result = JSON.parse(responseText);
              } catch {
                throw new Error(
                  response.ok
                    ? "The server returned an invalid response. Check whether your vote was saved before trying again."
                    : `Your vote was not saved (server returned HTTP ${response.status}). Please try again.`
                );
              }
              if (!response.ok) throw new Error(result.message || "Could not save your vote.");
              if (
                result.success !== true ||
                !Array.isArray(result.counts) ||
                !Number.isInteger(result.optionIndex)
              ) {
                throw new Error("The server returned incomplete poll results. Refresh to check your vote.");
              }
              const total = result.counts.reduce((sum, count) => sum + count, 0);
              buttons.forEach((item, index) => {
                const count = result.counts[index] || 0;
                const percent = total ? Math.round(count / total * 100) : 0;
                const selected = index === result.optionIndex;
                item.classList.toggle("selected", selected);
                item.setAttribute("aria-pressed", String(selected));
                item.querySelector(".poll-option-fill").value = percent;
                item.querySelector(".poll-option-result").textContent = `${percent}% · ${count}`;
              });
              const totalLabel = poll.querySelector(".poll-question > span");
              totalLabel.textContent = `${total} ${total === 1 ? "vote" : "votes"}`;
              poll.querySelector(".poll-footnote").textContent = "Your vote is saved. You can change it.";
            } catch (requestError) {
              error.textContent = requestError.message || "Could not save your vote.";
              error.hidden = false;
            } finally {
              buttons.forEach((item) => { item.disabled = false; });
            }
          });
        });
      });

      document.querySelectorAll(".comment-toggle").forEach((button) => {
        button.addEventListener("click", () => {
          const form = button.closest(".post").querySelector(".comment-form");
          form.hidden = !form.hidden;
          if (!form.hidden) form.querySelector("input").focus();
        });
      });

      document.querySelectorAll(".comment-form").forEach((form) => {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const input = form.querySelector("input");
          const submit = form.querySelector("button");
          submit.disabled = true;
          try {
            const response = await fetch(`/posts/${form.dataset.id}/comments`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ text: input.value })
            });
            if (redirectToLoginIfNeeded(response)) return;
            const result = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(result.message || "Comment failed.");
            const line = document.createElement("div");
            line.className = "comment";
            const author = document.createElement("strong");
            author.textContent = `@${result.comment.handle}`;
            line.append(author, document.createTextNode(result.comment.text));
            form.parentElement.querySelector(".comment-list").append(line);
            input.value = "";
            const counter = form.closest(".post").querySelector(".comment-toggle span");
            if (counter) counter.textContent = result.count;
          } catch (error) {
            showToast(error.message || "Your comment could not be saved.");
          } finally {
            submit.disabled = false;
          }
        });
      });

      document.querySelectorAll(".share-btn").forEach((button) => {
        button.addEventListener("click", async () => {
          const url = `${location.origin}/app#${button.dataset.id}`;
          try {
            if (navigator.share) await navigator.share({ title: "Chirpy post", url });
            else {
              await navigator.clipboard.writeText(url);
              button.title = "Link copied";
            }
          } catch (error) {
            if (error.name !== "AbortError") showToast("Couldn't share this post.");
          }
        });
      });

      document.querySelectorAll(".edit-post-trigger").forEach((button) => {
        button.addEventListener("click", () => {
          const dialog = document.getElementById("editPostDialog");
          const text = document.getElementById("editPostText");
          const form = document.getElementById("editPostForm");
          form.dataset.postId = button.dataset.postId;
          text.value = button.dataset.postText || "";
          document.getElementById("editPostError").hidden = true;
          const ownerMenu = postMenuStates.find((state) => state.panel.contains(button));
          if (ownerMenu) closePostMenu(ownerMenu);
          dialog.showModal();
          text.focus();
        });
      });

      const editPostForm = document.getElementById("editPostForm");
      if (editPostForm) {
        const editPostDialog = document.getElementById("editPostDialog");
        const editPostError = document.getElementById("editPostError");
        const saveEditPost = document.getElementById("saveEditPost");
        document.getElementById("cancelEditPost").addEventListener("click", () => editPostDialog.close());
        editPostForm.addEventListener("submit", async (event) => {
          event.preventDefault();
          saveEditPost.disabled = true;
          editPostError.hidden = true;
          try {
            const response = await fetch(`/posts/${editPostForm.dataset.postId}/edit`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ text: document.getElementById("editPostText").value })
            });
            if (redirectToLoginIfNeeded(response)) return;
            const result = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(result.message || "The post could not be updated.");
            editPostDialog.close();
            window.location.reload();
          } catch (error) {
            editPostError.textContent = error.message || "The post could not be updated.";
            editPostError.hidden = false;
          } finally {
            saveEditPost.disabled = false;
          }
        });
      }

    </script>
  <% } %>
  <dialog class="media-lightbox" id="mediaLightbox" aria-label="Image viewer">
    <div class="media-lightbox-head"><span>Post image</span><button type="button" id="closeMediaLightbox" aria-label="Close image">×</button></div>
    <img id="mediaLightboxImage" alt="Expanded post attachment" />
    <p class="image-load-fallback" id="lightboxImageFallback" hidden>Image unavailable.</p>
  </dialog>
  <script>
    document.querySelectorAll(".post-body").forEach((body) => {
      const text = body.textContent || "";
      const tokenPattern = /(^|[\s([{])(@[a-zA-Z0-9_]{3,20}|#[a-zA-Z0-9_]{1,40})/g;
      const fragment = document.createDocumentFragment();
      let cursor = 0;
      for (const match of text.matchAll(tokenPattern)) {
        const tokenStart = match.index + match[1].length;
        const token = match[2];
        if (tokenStart > cursor) fragment.append(document.createTextNode(text.slice(cursor, tokenStart)));
        const link = document.createElement("a");
        link.textContent = token;
        if (token[0] === "@") {
          link.href = `/profile/${encodeURIComponent(token.slice(1).toLowerCase())}`;
        } else {
          link.href = `/app?tab=explore&q=${encodeURIComponent(token)}`;
        }
        fragment.append(link);
        cursor = tokenStart + token.length;
      }
      if (cursor < text.length) fragment.append(document.createTextNode(text.slice(cursor)));
      body.replaceChildren(fragment);
    });

    const mediaLightbox = document.getElementById("mediaLightbox");
    const lightboxImage = document.getElementById("mediaLightboxImage");
    const lightboxFallback = document.getElementById("lightboxImageFallback");
    const closeMediaLightbox = document.getElementById("closeMediaLightbox");
    const closeLightbox = () => {
      mediaLightbox.close();
      lightboxImage.removeAttribute("src");
      lightboxImage.hidden = false;
      lightboxFallback.hidden = true;
    };
    document.querySelectorAll(".post-image-button").forEach((button) => {
      const image = button.querySelector("img");
      const fallback = button.querySelector(".image-load-fallback");
      image.addEventListener("error", () => {
        image.hidden = true;
        fallback.hidden = false;
      });
      button.addEventListener("click", () => {
        if (image.hidden) return;
        lightboxFallback.hidden = true;
        lightboxImage.hidden = false;
        lightboxImage.src = button.dataset.imageSrc;
        mediaLightbox.showModal();
        closeMediaLightbox.focus();
      });
    });
    closeMediaLightbox.addEventListener("click", closeLightbox);
    mediaLightbox.addEventListener("click", (event) => {
      if (event.target === mediaLightbox) closeLightbox();
    });
    lightboxImage.addEventListener("error", () => {
      lightboxImage.hidden = true;
      lightboxFallback.hidden = false;
    });
    mediaLightbox.addEventListener("close", () => {
      lightboxImage.removeAttribute("src");
      lightboxImage.hidden = false;
      lightboxFallback.hidden = true;
    });
    document.querySelectorAll(".local-time").forEach((element) => {
      const date = new Date(element.dateTime);
      if (Number.isFinite(date.getTime())) {
        element.textContent = new Intl.DateTimeFormat(undefined, {
          dateStyle: "medium",
          timeStyle: "short"
        }).format(date);
      }
    });
  </script>
</body>
</html>