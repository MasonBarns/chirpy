<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#08090d" />
  <title><%= page === "app" ? "Chirpy" : page === "public-profile" ? `${profileAccount.displayName} · Chirpy` : page === "error" ? `${statusCode || "Error"} · Chirpy` : page === "moderation" ? "Moderation · Chirpy" : page === "login" ? "Sign in · Chirpy" : page === "onboarding" ? "Profile setup · Chirpy" : page === "terminated" ? "Account status · Chirpy" : page === "terms" ? "Terms of Service · Chirpy" : page === "privacy" ? "Privacy Policy · Chirpy" : page === "landing" ? "Chirpy — Find your people" : "Chirpy — Under Maintenance" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style>
    :root {
      color-scheme: dark;
      --bg: #08090d;
      --panel: #101116;
      --text: #f2f3f7;
      --muted: #9295a1;
      --line: #262832;
      --accent: #ff4d14;
      --accent-light: #ff8057;
      --accent-soft: rgba(255,77,20,.12);
      --red: #ff5364;
      --green: #4bd39a;
      --blue: #3994ff;
    }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    body { margin: 0; min-height: 100vh; background: var(--bg); color: var(--text); font: 14px Inter,Arial,sans-serif; }
    a { color: inherit; text-decoration: none; }
    button,input,textarea,select { font: inherit; }
    button { color: inherit; cursor: pointer; }
    button:not(:disabled):hover { filter: brightness(1.07); }
    button:not(:disabled):active { transform: translateY(1px); }
    button,a,.nav-link,.tab,.profile-tab,.post-menu summary,.image-upload-button,.icon-btn {
      transition: color .16s ease,background-color .16s ease,border-color .16s ease,box-shadow .16s ease,transform .16s ease,opacity .16s ease,filter .16s ease;
    }
    button:active,.create-btn:active,.post-submit:active,.auth-btn:active { transform: translateY(1px) scale(.99); }
    button:focus-visible,a:focus-visible,summary:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible {
      outline: 2px solid rgba(255,128,87,.85); outline-offset: 2px;
    }
    .eyebrow,.timestamp,.mono { font-family: "DM Mono",monospace; }
    .muted { color: var(--muted); }

    .badge { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; margin-left: 4px; vertical-align: -4px; filter: drop-shadow(0 0 3px currentColor); }
    .badge svg { display: block; width: 100%; height: 100%; overflow: visible; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
    .badge.verified,.badge.staff-check { color: #ff8738; }
    .badge.partner { color: #ff304f; filter: drop-shadow(0 0 2px rgba(255,48,79,.95)) drop-shadow(0 0 7px rgba(255,32,62,.75)); }
    .badge.partner svg { filter: drop-shadow(0 0 2px rgba(255,35,65,.85)); }
    .badge.manager { color: #f4aa40; }
    .badge.moderator { color: #8b9cff; }
    .badge.owner { color: #ffcf55; }
    .mini-name > span { display: block; margin-top: 4px; color: var(--muted); font-size: 12px; font-weight: 400; }
    .mini-badges { display: inline-flex !important; align-items: center; gap: 2px; margin-left: 2px !important; color: var(--text) !important; }
    .mini-badges .badge { display: inline-flex; width: 16px; height: 16px; margin: 0; vertical-align: middle; }

    /* Wide maintenance screen */
    .maintenance-page {
      min-height: 100vh; display: grid; place-items: center; position: relative;
      overflow: hidden; padding: 72px 24px 36px; isolation: isolate;
      background: radial-gradient(ellipse at 8% 8%,rgba(255,77,20,.18),transparent 32%),
        radial-gradient(ellipse at 94% 90%,rgba(114,38,25,.18),transparent 34%),#060811;
    }
    .maintenance-page::before,.maintenance-page::after {
      content: ""; position: absolute; z-index: -2; pointer-events: none; border-radius: 50%;
      animation: maintenance-drift 28s ease-in-out infinite alternate;
    }
    .maintenance-page::before {
      width: 720px; height: 780px; top: -430px; left: -180px;
      border: 1px solid rgba(255,112,67,.13);
      background: radial-gradient(ellipse,rgba(255,77,20,.16),rgba(16,17,36,.43) 62%,transparent 70%);
      box-shadow: 0 0 0 34px rgba(255,77,20,.025),0 0 0 75px rgba(255,77,20,.018);
    }
    .maintenance-page::after {
      width: 740px; height: 800px; right: -310px; bottom: -490px;
      border: 1px solid rgba(255,112,67,.14);
      background: radial-gradient(ellipse,rgba(112,40,34,.24),rgba(13,14,34,.5) 62%,transparent 70%);
      animation-delay: -8s;
    }
    .ambient-glow { position: absolute; z-index: -1; width: 400px; height: 400px; border-radius: 50%; background: radial-gradient(circle,rgba(255,77,20,.17),transparent 70%); filter: blur(14px); pointer-events: none; animation: glow-float 10s ease-in-out infinite alternate; }
    .ambient-glow.one { top: 10%; left: 18%; }
    .ambient-glow.two { right: 10%; bottom: 5%; width: 470px; height: 470px; animation-delay: -5s; }
    .maintenance-dots { position: absolute; z-index: -1; width: 340px; height: 390px; opacity: .72; pointer-events: none; background-image: radial-gradient(circle,rgba(255,104,59,.95) 1.5px,transparent 2px); background-size: 20px 20px; mask-image: radial-gradient(ellipse,#000 5%,transparent 72%); animation: dots-drift 11s ease-in-out infinite alternate; }
    .maintenance-dots.top { top: -55px; left: 30%; transform: rotate(22deg); }
    .maintenance-dots.bottom { right: 1%; bottom: -100px; transform: rotate(24deg); animation-delay: -4s; }
    .maintenance-wordmark { position: absolute; top: 28px; left: max(30px,calc((100vw - 1170px)/2)); display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 800; letter-spacing: .09em; }
    .maintenance-wordmark img { display: block; width: 28px; height: 28px; object-fit: contain; }
    .maintenance-status-top { position: absolute; top: 37px; right: max(30px,calc((100vw - 1170px)/2)); color: #b4b8c7; font: 10px "DM Mono",monospace; letter-spacing: .04em; text-transform: uppercase; }
    .maintenance-status-top::before { content: ""; display: inline-block; width: 7px; height: 7px; margin-right: 9px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px rgba(255,77,20,.85); animation: pulse 1.8s ease-in-out infinite; }
    .maintenance-card { display: grid; grid-template-columns: minmax(0,1fr) 288px; width: min(890px,100%); min-height: 444px; overflow: hidden; border: 1px solid #302638; border-radius: 26px; background: rgba(8,12,27,.95); box-shadow: 0 35px 110px rgba(0,0,0,.48); animation: card-in .65s ease both; }
    .maintenance-main { display: flex; flex-direction: column; justify-content: center; padding: 52px 58px; }
    .maintenance-brand { display: flex; align-items: center; gap: 15px; margin-bottom: 38px; }
    .maintenance-logo { display: grid; width: 68px; height: 68px; flex: 0 0 68px; place-items: center; overflow: hidden; border: 1px solid rgba(255,111,69,.42); border-radius: 21px; background: linear-gradient(145deg,rgba(255,77,20,.27),#171326); }
    .maintenance-logo img { display: block; width: 48px; height: 48px; object-fit: contain; }
    .maintenance-brand-copy .eyebrow { margin-bottom: 7px; }
    .maintenance-brand-copy strong { font-size: 14px; letter-spacing: .03em; }
    .maintenance-kicker { margin: 0 0 16px; color: #ff936f; font: 500 10px "DM Mono",monospace; letter-spacing: .13em; text-transform: uppercase; }
    .maintenance-title { margin: 0; font-size: clamp(48px,6vw,62px); font-weight: 700; letter-spacing: -.075em; line-height: .98; }
    .maintenance-description { max-width: 470px; margin: 24px 0 0; color: #929bb8; font-size: 15px; line-height: 1.75; }
    .maintenance-side { display: flex; flex-direction: column; justify-content: center; padding: 42px 36px; border-left: 1px solid #302638; background: linear-gradient(160deg,rgba(57,30,37,.74),rgba(9,13,29,.9) 70%); }
    .maintenance-side-label { margin: 0 0 12px; color: #ffb098; font: 500 10px "DM Mono",monospace; letter-spacing: .12em; text-transform: uppercase; }
    .maintenance-status-box { padding: 16px; border: 1px solid rgba(255,104,59,.19); border-radius: 16px; background: rgba(7,11,25,.58); }
    .maintenance-status-box strong { display: flex; align-items: center; gap: 10px; font-size: 13px; }
    .maintenance-status-box strong::before { content: ""; width: 8px; height: 8px; flex: 0 0 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px rgba(255,77,20,.85); }
    .maintenance-status-box p { margin: 10px 0 0 18px; color: #9296a9; font-size: 11px; line-height: 1.6; }
    .maintenance-deployment { display: flex; justify-content: space-between; margin: 50px 0 10px; color: #b2b4c1; font: 10px "DM Mono",monospace; letter-spacing: .08em; text-transform: uppercase; }
    .maintenance-deployment strong { color: #ff936f; }
    .maintenance-progress { display: block; width: 100%; height: 7px; overflow: hidden; border: 0; border-radius: 99px; background: #302735; appearance: none; }
    .maintenance-progress::-webkit-progress-bar { border-radius: 99px; background: #302735; }
    .maintenance-progress::-webkit-progress-value { border-radius: 99px; background: linear-gradient(90deg,#ff4d14,#ff9a57); animation: progress-glow 2.3s ease-in-out infinite alternate; }
    .maintenance-progress::-moz-progress-bar { border-radius: 99px; background: linear-gradient(90deg,#ff4d14,#ff9a57); }
    .maintenance-admin,.primary-button { width: 100%; min-height: 46px; margin-top: 22px; border: 1px solid rgba(255,160,126,.32); border-radius: 11px; background: linear-gradient(100deg,#ff4d14,#ff7040); color: white; font-weight: 700; }
    .maintenance-admin:disabled { cursor: wait; opacity: .7; }
    .maintenance-password { width: 100%; height: 44px; margin-top: 12px; padding: 0 13px; border: 1px solid #44303a; border-radius: 9px; outline: none; background: #080c19; color: white; }
    .maintenance-error { margin: 8px 0 0; color: #ff8796; font-size: 11px; }
    .maintenance-thanks { margin: 15px 0 0; color: #83859a; font-size: 11px; line-height: 1.6; }
    .maintenance-side > a.maintenance-thanks { display: block; color: #ff9b7a; text-align: center; text-decoration: underline; text-underline-offset: 3px; }

    /* Public landing */
    .landing-page { min-height: 100vh; position: relative; overflow: hidden; isolation: isolate; background: radial-gradient(ellipse at 50% 45%,rgba(255,77,20,.12),transparent 38%),#08090d; }
    .landing-page::before { content: ""; position: absolute; z-index: -2; inset: 0; opacity: .34; pointer-events: none; background-image: radial-gradient(circle,rgba(255,111,65,.72) 1px,transparent 1.6px); background-size: 12px 12px; mask-image: radial-gradient(ellipse 54% 43% at 50% 48%,#000 5%,transparent 100%); }
    .landing-page::after { content: ""; position: absolute; z-index: -1; top: 14%; left: 50%; width: min(880px,94vw); height: 530px; transform: translateX(-50%); border: 1px solid rgba(255,111,65,.09); border-radius: 50%; box-shadow: 0 0 0 38px rgba(255,77,20,.018),0 0 0 92px rgba(255,77,20,.014); pointer-events: none; }
    .landing-header { display: flex; width: min(1200px,calc(100% - 64px)); height: 88px; align-items: center; justify-content: space-between; margin: 0 auto; border-bottom: 1px solid rgba(255,255,255,.08); }
    .landing-brand { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 800; letter-spacing: .14em; }
    .landing-brand img { width: 31px; height: 31px; object-fit: contain; }
    .landing-nav { display: flex; align-items: center; gap: 30px; color: #a6a6b0; font-size: 12px; }
    .landing-nav a:hover { color: white; }
    .landing-nav .landing-signin { padding: 10px 17px; border: 1px solid rgba(255,255,255,.19); border-radius: 8px; color: white; }
    .landing-nav .landing-signin:hover { border-color: rgba(255,112,65,.8); }
    .landing-hero { display: flex; min-height: calc(100vh - 89px); flex-direction: column; align-items: center; justify-content: center; padding: 40px 24px 88px; text-align: center; }
    .landing-logo { display: grid; width: 98px; height: 98px; place-items: center; margin-bottom: 25px; border: 1px solid rgba(255,115,71,.34); border-radius: 29px; background: linear-gradient(145deg,rgba(255,77,20,.22),rgba(20,14,18,.88)); box-shadow: 0 0 75px rgba(255,77,20,.2),inset 0 1px rgba(255,255,255,.08); animation: card-in .8s ease both; }
    .landing-logo img { width: 69px; height: 69px; object-fit: contain; }
    .landing-kicker { margin: 0 0 17px; color: #ff956e; font: 500 10px "DM Mono",monospace; letter-spacing: .19em; text-transform: uppercase; }
    .landing-title { max-width: 820px; margin: 0; font-size: clamp(48px,8vw,92px); font-weight: 700; letter-spacing: -.085em; line-height: .98; }
    .landing-title span { color: #ff6335; }
    .landing-description { max-width: 510px; margin: 23px 0 0; color: #a4a4b0; font-size: 15px; line-height: 1.75; }
    .landing-cta { display: inline-flex; min-height: 51px; align-items: center; justify-content: center; gap: 11px; margin-top: 33px; padding: 0 23px; border: 1px solid rgba(255,153,120,.32); border-radius: 10px; background: linear-gradient(105deg,#ff4d14,#ff7040); box-shadow: 0 12px 35px rgba(255,77,20,.22); color: white; font-weight: 700; transition: transform .18s ease,box-shadow .18s ease; }
    .landing-cta:hover { transform: translateY(-2px); box-shadow: 0 16px 42px rgba(255,77,20,.32); }
    .landing-cta svg { width: 18px; height: 18px; fill: currentColor; }
    .landing-footnote { margin: 15px 0 0; color: #777985; font-size: 11px; }
    .landing-legal-links { display: flex; gap: 18px; margin-top: 30px; color: #888a96; font-size: 11px; }
    .landing-legal-links a:hover,.legal-nav a:hover { color: #ff956e; }
    .legal-page { min-height: 100vh; background: radial-gradient(ellipse at 50% 0,rgba(255,77,20,.1),transparent 38%),#08090d; }
    .legal-header { display: flex; width: min(1100px,calc(100% - 48px)); height: 78px; align-items: center; justify-content: space-between; margin: 0 auto; border-bottom: 1px solid rgba(255,255,255,.09); }
    .legal-brand { display: inline-flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 800; letter-spacing: .13em; }
    .legal-brand img { width: 29px; height: 29px; object-fit: contain; }
    .legal-nav { display: flex; gap: 20px; color: #a5a6b1; font-size: 12px; }
    .legal-content { width: min(820px,calc(100% - 48px)); margin: 0 auto; padding: 72px 0 96px; }
    .legal-content .eyebrow { color: #ff956e; font-size: 10px; letter-spacing: .14em; text-transform: uppercase; }
    .legal-content h1 { margin: 12px 0; font-size: clamp(38px,7vw,62px); letter-spacing: -.06em; }
    .legal-intro { max-width: 680px; margin: 0 0 42px; color: #aaabb5; font-size: 15px; line-height: 1.8; }
    .legal-content section { margin: 30px 0; }
    .legal-content h2 { margin: 0 0 10px; font-size: 19px; }
    .legal-content p,.legal-content li { color: #b8bac4; font-size: 13px; line-height: 1.85; }
    .legal-content ul { padding-left: 21px; }
    .legal-contact-note { margin-top: 44px; padding: 16px 18px; border: 1px solid #39303a; border-radius: 10px; background: rgba(255,77,20,.06); color: #d2c9cc; font-size: 12px; line-height: 1.7; }

    /* Auth */
    .auth-page { min-height: 100vh; display: grid; place-items: center; position: relative; overflow: hidden; padding: 76px 20px 36px; isolation: isolate; background: radial-gradient(ellipse at 7% 8%,rgba(255,77,20,.15),transparent 34%),radial-gradient(ellipse at 96% 92%,rgba(119,40,27,.17),transparent 36%),#070811; }
    .auth-page::before,.auth-page::after { content: ""; position: absolute; z-index: -1; width: 680px; height: 680px; border: 1px solid rgba(255,110,70,.1); border-radius: 50%; pointer-events: none; animation: orbit 34s linear infinite; }
    .auth-page::before { top: -480px; left: -210px; box-shadow: 0 0 0 34px rgba(255,77,20,.025),0 0 0 72px rgba(255,77,20,.018); }
    .auth-page::after { right: -450px; bottom: -500px; animation-direction: reverse; }
    .auth-brand { position: absolute; top: 25px; left: 30px; z-index: 1; display: flex; align-items: center; gap: 9px; font-weight: 800; letter-spacing: .13em; }
    .auth-brand img { width: 26px; height: 26px; object-fit: contain; }
    .auth-card { position: relative; z-index: 1; width: min(480px,100%); padding: 42px; border: 1px solid #302a34; border-radius: 20px; background: rgba(12,14,24,.95); box-shadow: 0 32px 100px rgba(0,0,0,.48); animation: card-in .55s ease both; }
    .auth-logo { display: grid; width: 58px; height: 58px; place-items: center; margin-bottom: 24px; border: 1px solid rgba(255,111,69,.34); border-radius: 17px; background: rgba(255,77,20,.1); }
    .auth-logo img { width: 42px; height: 42px; object-fit: contain; }
    .eyebrow { margin: 0; color: #ff9b7a; font-size: 10px; letter-spacing: .14em; text-transform: uppercase; }
    .auth-card h1 { margin: 9px 0 12px; font-size: clamp(29px,6vw,39px); letter-spacing: -.06em; line-height: 1.08; }
    .auth-card > p,.auth-card form > p { color: #a5a9b7; line-height: 1.7; }
    .auth-card label { display: block; margin-top: 18px; color: #c5c7d0; font-size: 12px; font-weight: 600; }
    .auth-input,.field { width: 100%; height: 44px; margin-top: 8px; padding: 0 12px; border: 1px solid #34333e; border-radius: 9px; outline: none; background: #090a11; color: var(--text); }
    .auth-input:focus,.field:focus { border-color: var(--accent); }
    .auth-btn { display: inline-flex; width: 100%; min-height: 47px; align-items: center; justify-content: center; margin-top: 18px; border: 0; border-radius: 9px; background: var(--accent); font-weight: 700; }
    .form-error { color: #ff8996 !important; font-size: 12px; }
    .back-home { display: inline-block; margin-top: 20px; color: #a5abc0; font-size: 12px; }
    .onboarding-meta { display: flex; align-items: center; gap: 10px; margin: 24px 0 22px; }
    .onboarding-meta span { height: 1px; flex: 1; background: #33303a; }
    .onboarding-meta small { color: #8f92a0; font: 10px "DM Mono",monospace; text-transform: uppercase; }
    .handle-prefix { position: relative; }
    .handle-prefix::before { content: "@"; position: absolute; z-index: 1; top: 22px; left: 13px; color: #8d909d; }
    .handle-prefix .auth-input { padding-left: 30px; }
    .input-hint { margin: 8px 0 0 !important; color: #777b89 !important; font-size: 11px; }
    .form-footnote { display: flex; gap: 9px; margin-top: 17px; padding: 12px; border: 1px solid #302b30; border-radius: 9px; color: #9295a1; font-size: 11px; line-height: 1.55; }
    .form-footnote svg { width: 16px; height: 16px; flex: 0 0 16px; color: var(--accent-light); }
    .termination-page { min-height: 100vh; display: grid; place-items: center; position: relative; overflow: hidden; padding: 90px 20px 36px; isolation: isolate; background: radial-gradient(ellipse at 8% 8%,rgba(255,77,20,.2),transparent 36%),radial-gradient(ellipse at 93% 90%,rgba(119,40,27,.17),transparent 36%),#070811; }
    .termination-page::before { content: ""; position: absolute; z-index: -1; inset: 0; opacity: .2; pointer-events: none; background-image: radial-gradient(circle,rgba(255,111,65,.75) 1px,transparent 1.7px); background-size: 15px 15px; mask-image: radial-gradient(ellipse 55% 48% at 50% 50%,#000 5%,transparent 100%); }
    .termination-wordmark { position: absolute; top: 26px; left: max(24px,calc((100vw - 1060px)/2)); display: flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 800; letter-spacing: .13em; }
    .termination-wordmark img { width: 29px; height: 29px; object-fit: contain; }
    .termination-card { width: min(560px,100%); padding: clamp(25px,6vw,44px); border: 1px solid #3a2c31; border-radius: 21px; background: rgba(12,14,24,.96); box-shadow: 0 32px 100px rgba(0,0,0,.55),0 0 70px rgba(255,77,20,.08); }
    .termination-icon { display: grid; width: 54px; height: 54px; place-items: center; margin-bottom: 22px; border: 1px solid rgba(255,103,67,.38); border-radius: 17px; background: rgba(255,77,20,.12); color: #ff825f; font-size: 24px; }
    .termination-card h1 { margin: 10px 0; font-size: clamp(29px,6vw,40px); letter-spacing: -.06em; }
    .termination-card > p { color: #a5a9b7; line-height: 1.75; }
    .termination-detail { margin: 20px 0; padding: 14px 15px; border: 1px solid #302d35; border-radius: 10px; background: #0b0c12; color: #c9c5ca; font-size: 12px; line-height: 1.7; overflow-wrap: anywhere; }
    .termination-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
    .termination-actions a,.termination-actions button { display: inline-flex; min-height: 42px; align-items: center; justify-content: center; padding: 0 15px; border: 1px solid #39353d; border-radius: 9px; background: #16171e; color: #dddde3; font-size: 12px; font-weight: 650; }
    .termination-actions a.primary { border-color: transparent; background: linear-gradient(100deg,#ff4d14,#ff7040); color: white; }
    .termination-actions form { margin: 0; }
    .appeal-card { margin: 20px 0; padding: 16px; border: 1px solid #3b3034; border-radius: 12px; background: linear-gradient(140deg,rgba(255,77,20,.07),#0b0c12 68%); }
    .appeal-card h2 { margin: 0; font-size: 15px; }
    .appeal-card p,.appeal-status { color: #aeb0bb; font-size: 12px; line-height: 1.65; }
    .appeal-card form { display: grid; gap: 10px; margin-top: 13px; }
    .appeal-card textarea { width: 100%; min-height: 120px; padding: 11px 12px; border: 1px solid #39333b; border-radius: 9px; background: #08090e; color: var(--text); resize: vertical; }
    .appeal-card button { min-height: 42px; padding: 0 14px; border: 0; border-radius: 8px; background: linear-gradient(100deg,#ff4d14,#ff7040); color: #fff; font-weight: 700; }
    .appeal-notice { margin: 14px 0; padding: 11px 13px; border: 1px solid rgba(255,128,87,.32); border-radius: 9px; background: rgba(255,77,20,.08); color: #ffc0a7; font-size: 12px; line-height: 1.6; }
    .appeal-window { color: #ffc092 !important; }

    /* App shell and feed */
    .app-shell { display: grid; width: min(1120px,100%); min-height: 100vh; grid-template-columns: 230px minmax(390px,760px); gap: 28px; margin: 0 auto; padding: 0 28px; }
    .sidebar { position: sticky; top: 0; display: flex; height: 100vh; flex-direction: column; padding: 19px 9px 14px 0; border-right: 1px solid #21232b; }
    .brand { display: flex; align-items: center; gap: 11px; padding: 0 10px 22px; font-weight: 800; letter-spacing: .13em; }
    .brand img { width: 30px; height: 30px; object-fit: contain; }
    .brand-name { font-size: 12px; }
    .profile-mini { display: flex; align-items: center; gap: 10px; padding: 15px 8px; margin: 0 8px 17px 0; border-top: 1px solid #20222a; border-bottom: 1px solid #20222a; }
    .avatar { display: grid; width: 38px; height: 38px; flex: 0 0 38px; place-items: center; overflow: hidden; border: 1px solid #343540; border-radius: 50%; background: #29201f; color: white; font-weight: 700; }
    .avatar img { width: 100%; height: 100%; object-fit: cover; }
    .avatar img[data-fallback] { display: none; }
    .avatar img:not([data-fallback]) + span { display: none; }
    .avatar.small { width: 34px; height: 34px; flex-basis: 34px; }
    .avatar.large { width: 84px; height: 84px; flex-basis: 84px; font-size: 26px; }
    .mini-name { min-width: 0; font-weight: 650; }
    .nav { display: grid; gap: 4px; }
    .nav-link { display: flex; min-height: 43px; align-items: center; gap: 13px; padding: 0 12px; border-radius: 9px; color: #d0d1d7; }
    .nav-link:hover { background: #191513; color: white; }
    .nav-link.active { background: var(--accent-soft); color: #ff8057; }
    .nav-link svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
    .nav-link.settings-link svg { width: 22px; height: 22px; stroke-width: 2.7; }
    .create-btn,.post-submit { min-height: 41px; border: 0; border-radius: 9px; background: var(--accent); color: white; font-weight: 700; }
    .create-btn { margin-top: 17px; }
    .sidebar-bottom { display: flex; align-items: center; gap: 9px; margin-top: auto; padding: 12px 5px 0 2px; }
    .sidebar-bottom .mini-name { flex: 1; font-size: 12px; }
    .logout-btn { padding: 7px; border: 0; background: transparent; color: #8d909b; }
    .feed { min-width: 0; padding: 12px 0 60px; }
    .feed-top { position: sticky; top: 0; z-index: 3; display: flex; align-items: center; gap: 12px; padding: 5px 0 12px; border-bottom: 1px solid #20222a; background: rgba(8,9,13,.92); backdrop-filter: blur(12px); }
    .search-form { display: flex; flex: 1; }
    .search-input { width: 100%; height: 38px; padding: 0 14px; border: 1px solid #272a34; border-radius: 9px; outline: 0; background: #121318; color: white; }
    .search-input:focus { border-color: var(--accent); }
    .feed-heading { padding: 22px 0 14px; }
    .feed-heading h1,.settings-intro h1 { margin: 0; font-size: 25px; letter-spacing: -.04em; }
    .feed-heading p,.settings-intro p { margin: 7px 0 0; color: var(--muted); font-size: 13px; }
    .tabs,.profile-tabs { display: flex; border-bottom: 1px solid #252730; }
    .tab,.profile-tab { flex: 1; padding: 13px; color: #999ca6; text-align: center; }
    .tab.active,.profile-tab.active { border-bottom: 2px solid var(--accent); color: white; }
    .composer { margin: 16px 0 20px; padding: 16px; border: 1px solid #292b33; border-radius: 12px; background: linear-gradient(135deg,#121318,#0e0f14); }
    .composer-row { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 12px; }
    .composer-identity { display: flex; align-items: center; gap: 9px; }
    .composer-label { display: grid; gap: 3px; min-width: 0; }
    .composer-label strong { max-width: 145px; overflow: hidden; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
    .composer-label > span { display: flex; align-items: center; }
    .composer-label .badge { width: 16px; height: 16px; margin: 0 3px 0 0; vertical-align: middle; }
    .composer textarea { width: auto; min-width: 200px; min-height: 74px; flex: 1 1 240px; resize: vertical; border: 0; outline: 0; background: transparent; color: var(--text); font-size: 15px; }
    .composer-bottom { display: flex; align-items: center; gap: 10px; padding-top: 10px; border-top: 1px solid #292b33; }
    .composer-bottom input { min-width: 0; flex: 1; padding: 9px; border: 1px solid #272a34; border-radius: 8px; background: #0a0b10; color: white; }
    .composer-upload-row { display: flex; align-items: center; gap: 12px; padding-top: 11px; }
    .composer-poll-row { padding-top: 9px; }
    .poll-toggle { padding: 7px 10px; border: 1px solid #30323c; border-radius: 8px; background: #17181f; color: #c5c7d0; font-size: 11px; }
    .poll-toggle[aria-pressed="true"] { border-color: rgba(255,77,20,.5); color: #ff956e; }
    .poll-editor { display: grid; gap: 8px; margin-top: 10px; }
    .poll-editor input { width: 100%; padding: 9px 11px; border: 1px solid #30323c; border-radius: 8px; background: #0a0b10; color: white; }
    .image-upload-button { display: inline-flex; min-height: 36px; align-items: center; justify-content: center; padding: 0 12px; border: 1px solid #30323c; border-radius: 8px; background: #17181f; color: #dadbe2; font-size: 12px; font-weight: 600; cursor: pointer; }
    .image-upload-button:hover { border-color: var(--accent); color: white; }
    .image-upload-input { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); clip-path: inset(50%); white-space: nowrap; }
    .upload-name { min-width: 0; overflow: hidden; color: #9b9eaa; font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
    .upload-error { margin: 8px 0 0; color: #ff8796; font-size: 12px; }
    .image-preview { position: relative; width: fit-content; max-width: 100%; margin-top: 12px; }
    .image-preview img { display: block; max-width: min(100%,360px); max-height: 260px; border: 1px solid #363842; border-radius: 10px; object-fit: contain; }
    .image-preview button { position: absolute; top: 8px; right: 8px; padding: 6px 9px; border: 1px solid rgba(255,255,255,.2); border-radius: 7px; background: rgba(9,10,14,.88); font-size: 11px; }
    .char-count { color: #858895; font: 11px "DM Mono",monospace; }
    .post-submit { padding: 9px 16px; }
    .post-submit:disabled { opacity: .45; cursor: not-allowed; }
    .post { padding: 19px 0 17px; border-bottom: 1px solid #22242c; animation: card-in .32s cubic-bezier(.2,.7,.25,1) both; }
    .post-header { display: flex; align-items: center; gap: 10px; }
    .post-author { min-width: 0; flex: 1; }
    .author-line { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
    .author-name { font-weight: 700; }
    .author-handle,.timestamp { color: #858894; font-size: 12px; }
    .post-body { margin: 10px 0 12px 44px; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.65; }
    .post-body a,.notification-card a { color: #ff956e; text-decoration: underline; text-decoration-color: rgba(255,149,110,.45); text-underline-offset: 2px; }
    .post-body a:hover,.notification-card a:hover { color: #ffb194; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
    .post-image { display: block; max-width: calc(100% - 44px); max-height: 440px; margin: 10px 0 12px 44px; border: 1px solid #2b2d36; border-radius: 10px; object-fit: cover; }
    .poll-card { margin: 13px 0 12px 44px; padding: 14px; border: 1px solid #2b2d36; border-radius: 11px; background: #101116; }
    .poll-question { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 11px; }
    .poll-question strong { font-size: 13px; line-height: 1.5; }
    .poll-question > span { flex: 0 0 auto; color: #858894; font-size: 10px; }
    .poll-options { display: grid; gap: 7px; }
    .poll-option-button { position: relative; display: flex; min-height: 38px; align-items: center; justify-content: space-between; gap: 10px; overflow: hidden; padding: 8px 10px; border: 1px solid #30323c; border-radius: 7px; background: #0a0b10; text-align: left; }
    .poll-option-button.selected { border-color: rgba(255,77,20,.75); }
    .poll-option-fill { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: transparent; pointer-events: none; appearance: none; }
    .poll-option-fill::-webkit-progress-bar { background: transparent; }
    .poll-option-fill::-webkit-progress-value { background: rgba(255,77,20,.16); }
    .poll-option-fill::-moz-progress-bar { background: rgba(255,77,20,.16); }
    .poll-option-label,.poll-option-result { position: relative; z-index: 1; }
    .poll-option-label { overflow-wrap: anywhere; }
    .poll-option-result { flex: 0 0 auto; color: #b9bbc5; font-size: 10px; }
    .poll-footnote { margin-top: 9px; color: #858894; font-size: 10px; }
    .post-actions { display: flex; justify-content: space-between; max-width: 470px; margin-left: 38px; }
    .post { position: relative; }
    .post-menu { position: relative; z-index: 2; flex: 0 0 auto; margin-left: auto; }
    .post-menu-trigger { display: grid; width: 36px; height: 36px; place-items: center; padding: 0; border: 1px solid transparent; border-radius: 9px; background: transparent; color: #9699a5; }
    .post-menu-trigger:hover,.post-menu-trigger[aria-expanded="true"] { border-color: #353741; background: #17181f; color: white; }
    .post-menu-trigger svg { width: 19px; height: 19px; fill: currentColor; }
    .post-menu-panel { position: fixed; z-index: 1000; display: grid; width: min(330px,calc(100vw - 24px)); max-height: min(76vh,560px); gap: 8px; padding: 12px; overflow: auto; overscroll-behavior: contain; border: 1px solid #3b3d48; border-radius: 13px; background: #111218; box-shadow: 0 20px 60px rgba(0,0,0,.68); opacity: 0; transform: translateY(-5px) scale(.985); transform-origin: top right; transition: opacity .15s ease,transform .15s ease; }
    .post-menu-panel.is-open { opacity: 1; transform: translateY(0) scale(1); }
    .post-menu-section { display: grid; min-width: 0; gap: 7px; padding: 2px 0 9px; border-bottom: 1px solid #292b34; }
    .post-menu-section:last-child { padding-bottom: 0; border-bottom: 0; }
    .post-menu-section h3 { margin: 0; color: #999ca7; font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
    .post-menu-panel button { width: 100%; min-width: 0; min-height: 38px; padding: 8px 10px; border: 1px solid #353741; border-radius: 8px; background: #191a22; color: #e0e1e7; text-align: left; font-size: 12px; white-space: normal; overflow-wrap: anywhere; }
    .post-menu-panel button:hover { border-color: #4b4d59; background: #202129; }
    .post-menu-panel button.danger { border-color: rgba(255,83,100,.22); background: rgba(255,83,100,.07); color: #ff9aa5; }
    .post-menu-panel form { display: grid; min-width: 0; gap: 7px; margin: 0; }
    .post-menu-panel select,.post-menu-panel input { display: block; width: 100%; min-width: 0; min-height: 38px; margin: 0; padding: 8px 10px; border: 1px solid #353741; border-radius: 8px; background: #0a0b10; color: var(--text); font-size: 12px; }
    .post-menu-panel .menu-field-label { color: #a2a4ae; font-size: 11px; }
    .post-image-button { display: block; max-width: calc(100% - 44px); margin: 10px 0 12px 44px; padding: 0; border: 0; border-radius: 10px; background: transparent; text-align: left; }
    .post-image { display: block; max-width: 100%; max-height: 440px; border: 1px solid #2b2d36; border-radius: 10px; object-fit: contain; }
    .image-load-fallback { display: block; padding: 18px; border: 1px solid #363842; border-radius: 10px; color: #a8aab4; font-size: 12px; }
    .post-image-button:hover .post-image { border-color: #6b4134; }
    .media-lightbox { width: min(1000px,calc(100% - 28px)); max-width: none; max-height: calc(100% - 28px); padding: 12px; overflow: auto; border: 1px solid #42444e; border-radius: 14px; background: #0b0c11; color: white; }
    .media-lightbox::backdrop { background: rgba(2,3,7,.86); backdrop-filter: blur(7px); }
    .media-lightbox-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; color: #b8bac4; font-size: 12px; }
    .media-lightbox-head button { min-width: 36px; min-height: 36px; border: 1px solid #383a45; border-radius: 8px; background: #17181f; }
    .media-lightbox img { display: block; max-width: 100%; max-height: calc(100vh - 100px); margin: auto; object-fit: contain; }
    .post-interaction-error { margin: 8px 0 0 44px; color: #ff8796; font-size: 11px; }
    .icon-btn { display: inline-flex; align-items: center; gap: 7px; padding: 6px 7px; border: 0; border-radius: 7px; background: transparent; color: #858894; font-size: 12px; }
    .icon-btn svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .icon-btn.liked { color: var(--red); }
    .icon-btn.liked svg { fill: var(--red); stroke: var(--red); animation: heart-pop .35s ease; }
    .icon-btn.reposted { color: var(--green); }
    .icon-btn.bookmarked { color: var(--accent-light); }
    .comment-list { margin: 8px 0 0 44px; }
    .comment { padding: 8px 0; color: #c9cbd4; font-size: 12px; line-height: 1.55; }
    .comment strong { margin-right: 6px; color: white; }
    .comment-form { display: flex; gap: 8px; margin: 8px 0 0 44px; }
    .comment-form input { min-width: 0; flex: 1; padding: 9px 11px; border: 1px solid #292c36; border-radius: 8px; background: #101116; color: white; }
    .comment-form button { border: 0; background: transparent; color: var(--accent-light); }
    .mod-actions { display: flex; flex-wrap: wrap; gap: 7px; margin: 12px 0 0 44px; }
    .mod-actions form { display: inline; }
    .mod-button,.role-button { padding: 7px 10px; border: 1px solid #343540; border-radius: 7px; background: #15161d; color: #c5c6ce; font-size: 11px; }
    .mod-button.danger { border-color: rgba(255,83,100,.3); color: #ff8796; }
    .mute-form { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
    .mute-form select,.mute-form input { max-width: 150px; min-height: 31px; padding: 5px 8px; border: 1px solid #343540; border-radius: 7px; background: #101116; color: var(--text); font-size: 11px; }
    .active-mute-meta { margin-top: 5px; color: #aeb0bb; font-size: 11px; line-height: 1.6; }
    .mute-banner { margin: 14px 0; padding: 14px 16px; border: 1px solid rgba(255,151,67,.34); border-radius: 11px; background: linear-gradient(120deg,rgba(255,121,38,.12),rgba(25,19,18,.84)); color: #f4d4c2; line-height: 1.6; }
    .mute-banner strong { color: #ffad79; }
    .mute-banner small { display: block; margin-top: 3px; color: #b9a99f; }
    .app-toast { position: fixed; z-index: 30; right: 24px; bottom: 24px; max-width: min(420px,calc(100vw - 32px)); padding: 13px 16px; border: 1px solid #4b3431; border-radius: 11px; background: #171318; color: #f0d9d4; box-shadow: 0 16px 50px rgba(0,0,0,.48); opacity: 0; pointer-events: none; transform: translateY(10px); transition: opacity .18s ease,transform .18s ease; }
    .app-toast.visible { opacity: 1; transform: translateY(0); }
    .repost-note { margin: 0 0 9px 44px; color: #7fbf9f; font-size: 11px; }
    .profile-header { padding: 25px 0 0; }
    .profile-info { display: flex; align-items: center; gap: 17px; }
    .profile-info h2 { margin: 0; font-size: 21px; }
    .profile-bio { margin: 17px 0 0; color: #b2b4bd; line-height: 1.6; }
    .profile-count { margin: 12px 0 18px; color: #858894; font-size: 12px; }
    .profile-tab { border-bottom: 2px solid transparent; font-size: 13px; font-weight: 600; }
    .right-rail { padding: 34px 0 20px; }
    .rail-card,.mod-card,.settings-card { margin-bottom: 15px; padding: 17px; border: 1px solid #252730; border-radius: 12px; background: #101116; animation: card-in .28s ease-out both; }
    .rail-card h2,.mod-card h2,.settings-card h2 { margin: 0 0 14px; font-size: 15px; }
    .trend { display: block; padding: 9px 0; color: var(--accent-light); }
    .trend small { display: block; margin-top: 4px; color: #777b87; }
    .rail-note { color: #9295a1; font-size: 12px; line-height: 1.6; }
    .empty { padding: 38px 20px; color: #989ba6; text-align: center; line-height: 1.7; }
    .empty strong { display: block; margin-bottom: 6px; color: #e6e7ec; font-size: 16px; }

    /* Settings and verification */
    .settings-intro { padding: 24px 0 19px; border-bottom: 1px solid #252730; }
    .settings-grid { display: grid; gap: 15px; padding-top: 17px; }
    .settings-card { padding: 20px; }
    .settings-card-heading { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
    .settings-card-icon { display: grid; width: 38px; height: 38px; flex: 0 0 38px; place-items: center; border: 1px solid rgba(255,77,20,.2); border-radius: 11px; background: var(--accent-soft); color: var(--accent-light); }
    .settings-card-icon svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
    .settings-card-heading h2 { margin: 0; font-size: 14px; }
    .settings-card-heading p { margin: 4px 0 0; color: #858995; font-size: 11px; }
    .settings-form,.handle-form { display: grid; gap: 13px; }
    .settings-form label,.handle-form label,.verification-form label { color: #c5c7d0; font-size: 12px; font-weight: 600; }
    .settings-form input,.settings-form textarea,.handle-form input,.verification-form textarea,.message-form input,.message-form textarea,.role-select {
      display: block; width: 100%; margin-top: 7px; padding: 11px 12px; border: 1px solid #30323c;
      border-radius: 8px; outline: none; background: #0b0c12; color: white;
    }
    .settings-form textarea,.verification-form textarea,.message-form textarea { min-height: 85px; resize: vertical; }
    .settings-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .settings-note { color: #7f8390; font-size: 11px; line-height: 1.55; }
    .handle-current { display: flex; justify-content: space-between; margin-bottom: 14px; padding: 12px; border: 1px solid #292b34; border-radius: 9px; }
    .handle-current span { color: #858995; font-size: 11px; }
    .handle-status { padding: 11px 12px; border: 1px solid #333039; border-radius: 9px; color: #9a9ca8; font-size: 11px; line-height: 1.55; }
    .settings-error { color: #ff8996; font-size: 12px; }
    .settings-saved { color: var(--green); font-size: 12px; }
    .verification-form { display: grid; gap: 12px; }
    .status-label { color: #aaa; font-size: 12px; }
    .status-pending { color: #ffbd72; }
    .status-verified { color: #ff8738; }
    .status-rejected { color: #ff8996; }

    /* Moderation panel */
    .mod-section-title { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
    .mod-section-title small { color: var(--muted); font-size: 11px; }
    .mod-user { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 12px; align-items: center; padding: 12px 0; border-top: 1px solid #252730; }
    .mod-user.staff-account { grid-template-columns: minmax(0,1fr); align-items: stretch; gap: 14px; margin-top: 12px; padding: 15px; border: 1px solid #2d303a; border-radius: 11px; background: linear-gradient(135deg,#12141b,#0d0e14); }
    .staff-account-info,.staff-account-actions,.staff-action-group { min-width: 0; }
    .staff-account-info { overflow-wrap: anywhere; }
    .staff-account-actions { display: grid; gap: 10px; }
    .staff-action-group { display: grid; grid-template-columns: minmax(85px, .28fr) minmax(0,1fr); align-items: center; gap: 10px; padding-top: 10px; border-top: 1px solid #272a33; }
    .staff-action-label { color: #989ba7; font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
    .staff-action-group form { min-width: 0; margin: 0; }
    .staff-action-group select,.staff-action-group input { width: 100%; min-width: 0; max-width: 100%; min-height: 36px; margin: 0; padding: 7px 9px; border: 1px solid #343641; border-radius: 7px; background: #0a0b10; color: var(--text); font-size: 11px; }
    .staff-action-group button { min-height: 36px; white-space: nowrap; }
    .staff-role-form { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 8px; }
    .staff-mute-form { display: grid; grid-template-columns: minmax(110px,.7fr) minmax(0,1.3fr) auto; gap: 8px; }
    .staff-terminate-form { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 8px; }
    .staff-action-group .termination-reason { width: 100% !important; }
    .mod-user-name { font-weight: 650; }
    .mod-user-meta { margin-top: 4px; color: #8b8e9a; font-size: 11px; }
    .mod-controls { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; min-width: 0; }
    .role-form { display: flex; gap: 6px; align-items: center; }
    .role-form .field { width: auto; max-width: 220px; margin: 0; }
    .role-select { width: auto; min-width: 105px; margin: 0; padding: 7px; font-size: 11px; }
    .role-assignee { display: flex; min-width: 0; align-items: center; gap: 10px; }
    .role-assignee-copy { display: grid; gap: 3px; min-width: 0; }
    .role-assignee-copy strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .role-assignee-copy span { color: var(--muted); font-size: 11px; }
    .role-assignment-preview { display: flex; min-height: 40px; flex: 1 0 100%; align-items: center; gap: 9px; color: #c5c7d0; font-size: 11px; }
    .partner-badge-tools { display: grid; gap: 10px; }
    .partner-badge-tools > label { display: grid; gap: 7px; color: #c5c7d0; font-size: 12px; }
    .partner-badge-tools > label input { width: 100%; height: 40px; padding: 0 11px; border: 1px solid #30323c; border-radius: 8px; background: #0b0c12; color: var(--text); }
    .partner-lookup-result { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 11px; border: 1px solid #2c2e39; border-radius: 9px; background: #0c0d13; color: #c5c7d0; font-size: 12px; }
    .partner-lookup-result .partner-status { flex: 1 1 180px; }
    .partner-lookup-result form { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .partner-lookup-result select { min-height: 36px; padding: 6px 9px; border: 1px solid #343641; border-radius: 7px; background: #0a0b10; color: var(--text); }
    .application-reason { margin: 10px 0; padding: 11px; border-radius: 8px; background: #0b0c12; color: #c5c7d0; font-size: 12px; line-height: 1.6; }
    .application-actions { display: flex; gap: 8px; }
    .application-actions form { flex: 1; }
    .application-actions button { width: 100%; }
    .empty-small { padding: 18px 0; color: #858995; font-size: 12px; }
    .message-list { display: grid; gap: 10px; }
    .message-bubble { max-width: 82%; padding: 11px 13px; border: 1px solid #292c36; border-radius: 12px; background: #13151c; line-height: 1.55; }
    .message-bubble.mine { justify-self: end; border-color: #633421; background: #291811; }
    .message-form { display: grid; gap: 9px; margin-top: 20px; padding-top: 16px; border-top: 1px solid #242630; }
    .notification-list { display: grid; gap: 9px; }
    .notification-card { display: flex; align-items: center; gap: 12px; padding: 14px; border: 1px solid #292c36; border-radius: 11px; background: #111218; color: #c5c7d0; line-height: 1.5; animation: card-in .28s ease-out both; }
    .notification-card.unread { border-color: rgba(255,77,20,.42); background: linear-gradient(110deg,rgba(255,77,20,.08),#111218 65%); }
    .notification-card .avatar { flex: 0 0 38px; }
    .public-profile-page { width: min(720px,calc(100% - 32px)); min-height: 100vh; margin: 0 auto; border-right: 1px solid #242630; border-left: 1px solid #242630; padding: 18px 24px 60px; }
    .public-profile-head { display: flex; align-items: center; gap: 14px; padding: 24px 0; border-bottom: 1px solid #252730; }
    .public-profile-head h1 { margin: 0 0 5px; font-size: 23px; }
    .public-profile-bio { margin: 0; padding: 14px 0; color: #aeb0bb; line-height: 1.6; }
    .public-profile-home { display: inline-flex; align-items: center; gap: 8px; color: #ff956e; font-size: 12px; }
    .profile-stats { display: flex; flex-wrap: wrap; gap: 18px; padding: 12px 0; border-bottom: 1px solid #252730; color: #9699a5; font-size: 11px; }
    .profile-stats strong { color: #f2f3f7; font-size: 13px; }
    .public-profile-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 13px; }
    .public-profile-tabs { display: flex; gap: 18px; border-bottom: 1px solid #252730; }
    .public-profile-tab { padding: 11px 5px; border-bottom: 2px solid transparent; color: #999ca6; font-size: 12px; font-weight: 600; }
    .public-profile-tab.active { border-color: var(--accent); color: white; }
    .follow-button { display: inline-flex; min-width: 98px; min-height: 36px; align-items: center; justify-content: center; padding: 0 13px; border: 1px solid rgba(255,128,87,.55); border-radius: 9px; background: var(--accent-soft); color: #ffad91; font-size: 12px; font-weight: 700; text-decoration: none; }
    .follow-button:hover { background: rgba(255,77,20,.22); }
    .profile-notice { margin: 12px 0; padding: 10px 12px; border: 1px solid rgba(75,211,154,.28); border-radius: 9px; background: rgba(75,211,154,.07); color: #9ae2c1; font-size: 12px; }
    .profile-avatar-link { flex: 0 0 auto; }
    .author-name { color: inherit; }
    .signout-button { padding: 9px 12px; border: 1px solid #38303a; border-radius: 8px; background: transparent; color: #c6c6ce; }
    .confirm-dialog { width: min(440px,calc(100% - 32px)); padding: 0; border: 1px solid #3b2e32; border-radius: 18px; background: #111218; color: var(--text); box-shadow: 0 28px 100px rgba(0,0,0,.7); }
    .confirm-dialog[open],.verification-notice[open],.media-lightbox[open] { animation: modal-in .2s cubic-bezier(.2,.7,.25,1) both; }
    .confirm-dialog::backdrop { background: rgba(4,5,9,.78); backdrop-filter: blur(8px); }
    .confirm-content { padding: 25px; }
    .confirm-kicker { margin: 0 0 10px; color: #ff9878; font: 10px "DM Mono",monospace; letter-spacing: .13em; text-transform: uppercase; }
    .confirm-content h2 { margin: 0; font-size: 21px; letter-spacing: -.04em; }
    .confirm-content p { margin: 10px 0 0; color: #a6a8b2; line-height: 1.65; }
    .confirm-actions { display: flex; justify-content: flex-end; gap: 9px; margin-top: 24px; }
    .confirm-actions button { min-height: 39px; padding: 0 15px; border: 1px solid #383943; border-radius: 8px; background: #181920; }
    .confirm-actions .confirm-danger { border-color: rgba(255,83,100,.35); background: linear-gradient(100deg,#c83243,#f14e5e); font-weight: 700; }
    .verification-notice { width: min(470px,calc(100% - 32px)); padding: 0; border: 1px solid rgba(255,135,56,.45); border-radius: 19px; background: #111218; color: var(--text); box-shadow: 0 28px 100px rgba(0,0,0,.72),0 0 45px rgba(255,112,42,.1); }
    .verification-notice::backdrop { background: rgba(4,5,9,.8); backdrop-filter: blur(8px); }
    .verification-notice-content { padding: 27px; }
    .verification-notice-icon { display: grid; width: 48px; height: 48px; place-items: center; margin-bottom: 17px; border: 1px solid rgba(255,135,56,.35); border-radius: 15px; background: rgba(255,135,56,.12); color: #ff8738; font-size: 23px; }
    .verification-notice h2 { margin: 0; font-size: 21px; }
    .verification-notice p { color: #b2b4be; line-height: 1.7; }
    .verification-notice button { min-height: 40px; padding: 0 16px; border: 0; border-radius: 8px; background: linear-gradient(100deg,#ff4d14,#ff7040); font-weight: 700; }
    .termination-reason { width: 155px !important; }
    .terminated-meta { margin-top: 7px; color: #aeb0bb; font-size: 11px; line-height: 1.7; }
    .banland-actions { display: flex; justify-content: flex-end; }
    .unban-button { padding: 8px 12px; border: 1px solid rgba(75,211,154,.35); border-radius: 8px; background: rgba(75,211,154,.08); color: #75dfaf; font-weight: 650; }
    .mod-filter-form { display: flex; gap: 8px; margin: 14px 0; }
    .mod-filter-form input { min-width: 0; flex: 1; height: 40px; padding: 0 11px; border: 1px solid #30323c; border-radius: 8px; background: #0b0c12; color: var(--text); }
    .mod-filter-form button { min-height: 40px; padding: 0 13px; border: 1px solid #3a3b46; border-radius: 8px; background: #191a22; }
    .audit-list { display: grid; gap: 9px; margin-top: 15px; }
    .audit-entry { padding: 13px 14px; border: 1px solid #2b2d37; border-radius: 10px; background: #0d0f15; }
    .audit-entry-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 14px; }
    .audit-entry-head strong { color: #ffad8b; font-size: 12px; }
    .audit-entry-head time { color: #9295a1; font: 10px "DM Mono",monospace; }
    .audit-entry-meta { margin-top: 6px; color: #b8bac4; font-size: 11px; line-height: 1.6; overflow-wrap: anywhere; }
    .audit-entry-details { margin-top: 7px; color: #9699a5; font-size: 11px; line-height: 1.6; overflow-wrap: anywhere; white-space: pre-wrap; }
    .audit-pagination { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 16px; color: #999ca7; font-size: 11px; }
    .audit-pagination a { padding: 8px 11px; border: 1px solid #343641; border-radius: 7px; background: #15161d; }

    @keyframes card-in { from { opacity: 0; transform: translateY(9px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes modal-in { from { opacity: 0; transform: translateY(8px) scale(.985); } to { opacity: 1; transform: translateY(0) scale(1); } }
    @keyframes heart-pop { 50% { transform: scale(1.35); } }
    @keyframes orbit { to { rotate: 360deg; } }
    @keyframes maintenance-drift { to { transform: translate3d(22px,18px,0) rotate(4deg) scale(1.04); } }
    @keyframes glow-float { from { transform: translate3d(-20px,-12px,0) scale(.9); opacity: .5; } to { transform: translate3d(25px,24px,0) scale(1.12); opacity: 1; } }
    @keyframes dots-drift { from { translate: 0 0; opacity: .38; } to { translate: 18px 22px; opacity: .9; } }
    @keyframes pulse { 50% { opacity: .48; } }
    @keyframes progress-glow { to { box-shadow: 0 0 18px rgba(255,77,20,1); } }

    @media (max-width: 1050px) {
      .app-shell { grid-template-columns: 205px minmax(0,760px); gap: 24px; }
    }
    @media (max-width: 720px) {
      .maintenance-page { padding: 88px 18px 32px; }
      .maintenance-wordmark { top: 22px; left: 20px; }
      .maintenance-status-top { top: 29px; right: 20px; max-width: 145px; font-size: 8px; text-align: right; }
      .maintenance-card { grid-template-columns: 1fr; }
      .maintenance-main { padding: 32px 26px 28px; }
      .maintenance-side { padding: 26px; border-top: 1px solid #302638; border-left: 0; }
      .maintenance-deployment { margin-top: 27px; }
      .landing-header { width: calc(100% - 36px); height: 72px; }
      .landing-nav { gap: 15px; }
      .landing-nav a:first-child { display: none; }
      .legal-content { padding-top: 48px; }
      .legal-header { width: calc(100% - 32px); }
      .legal-nav { gap: 12px; font-size: 11px; }
      .landing-hero { min-height: calc(100vh - 73px); padding-bottom: 55px; }
      .landing-description { font-size: 14px; }
      .app-shell { display: block; padding: 0 16px 74px; }
      .sidebar { position: fixed; z-index: 10; top: auto; right: 0; bottom: 0; left: 0; width: 100%; height: 62px; padding: 6px 8px calc(6px + env(safe-area-inset-bottom)); border-top: 1px solid #242630; border-right: 0; background: rgba(9,10,15,.97); }
      .brand,.profile-mini,.create-btn,.sidebar-bottom,.nav-link span { display: none; }
      .nav { display: flex; height: 100%; justify-content: space-around; gap: 0; }
      .nav-link { min-width: 42px; min-height: 44px; justify-content: center; padding: 0 10px; }
      .feed { padding-top: 8px; }
      .post-body,.post-image-button,.comment-list,.comment-form,.poll-card,.post-interaction-error { margin-left: 0; }
      .post-image-button { max-width: 100%; }
      .auth-card { padding: 30px 24px; }
      .settings-card { padding: 16px; }
      .mod-user { grid-template-columns: 1fr; }
      .mod-controls { justify-content: flex-start; }
      .staff-action-group { grid-template-columns: 1fr; gap: 7px; }
      .staff-role-form,.staff-mute-form,.staff-terminate-form { grid-template-columns: minmax(0,1fr); }
      .staff-action-group button { width: 100%; white-space: normal; }
      .post-menu-panel { width: min(330px,calc(100vw - 24px)); max-height: 68vh; }
    }
    @media (prefers-reduced-motion: reduce) {
      *,*::before,*::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: .01ms !important; }
    }
  </style>
</head>

<body>
  <%
    const safePendingAppeals = typeof pendingAppeals !== "undefined" && Array.isArray(pendingAppeals) ? pendingAppeals : [];
    const safeBanlandQuery = typeof banlandQuery === "string" ? banlandQuery : "";
    const safeAppealNotice = typeof appealNotice === "string" ? appealNotice : "";
    const safeTerminatedAccount = typeof terminatedAccount !== "undefined" && terminatedAccount && typeof terminatedAccount === "object"
      ? terminatedAccount
      : {
          displayName: "Chirpy account",
          reason: "",
          terminatedAt: null,
          appealUsed: false,
          appealStatus: "",
          appealSubmittedAt: null,
          appealDecisionAt: null,
          appealEligible: false,
          appealClosesAt: null,
        };
    function renderPartnerBadge(account) {
      return account && account.partner
        ? '<span class="badge partner" role="img" aria-label="Partner" title="Partner"><svg aria-hidden="true"><use href="#i-partner"></use></svg></span>'
        : "";
    }
  %>
  <svg aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden">
    <symbol id="i-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1z"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="7.3"/><path d="m16.2 16.2 5 5"/></symbol>
    <symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></symbol>
    <symbol id="i-bell" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></symbol>
    <symbol id="i-bookmark" viewBox="0 0 24 24"><path d="M6 4.5A1.5 1.5 0 0 1 7.5 3h9A1.5 1.5 0 0 1 18 4.5V21l-6-4-6 4z"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></symbol>
    <symbol id="i-settings" viewBox="0 0 24 24"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1.08 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1.08 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v.1a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1.08Z"/></symbol>
    <symbol id="i-heart" viewBox="0 0 24 24"><path d="M20.8 8.7c0 5.5-8.8 11-8.8 11s-8.8-5.5-8.8-11A4.7 4.7 0 0 1 12 6.4a4.7 4.7 0 0 1 8.8 2.3Z"/></symbol>
    <symbol id="i-repost" viewBox="0 0 24 24"><path d="m17 2 4 4-4 4"/><path d="M3 11V9a3 3 0 0 1 3-3h15"/><path d="m7 22-4-4 4-4"/><path d="M21 13v2a3 3 0 0 1-3 3H3"/></symbol>
    <symbol id="i-comment" viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-9 8.5 9.4 9.4 0 0 1-4-.9L3 21l1.8-4.4A8 8 0 0 1 3 11.5 8.5 8.5 0 0 1 12 3a8.5 8.5 0 0 1 9 8.5Z"/></symbol>
